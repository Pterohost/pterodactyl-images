#!/bin/bash
# Pterohost Arma 3 bootstrap.
#
# Like DayZ, the Arma 3 server depot (app 233780) is not anonymous - it needs a
# Steam account that owns the game.
#
# Arma reserves a block of ports starting at -port: the game port itself, then
# +1 for the Steam query and +2/+3 for Steam's own use. The panel only
# allocates the game port, which is why its query registry allows an unassigned
# +1 for this game. Nothing to configure here, but it is worth knowing when a
# server does not show up: the neighbouring port may already be taken.

set -u
cd /home/container || exit 1

# shellcheck source=/dev/null
. /usr/local/lib/pterohost/steam-update.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/cfgconf.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/launch.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/workshop.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/rpt-tee.sh

log() { pterohost_log "$@"; }

APPID="${STEAMCMD_APPID:-233780}"
BINARY="${SERVER_BINARY:-arma3server_x64}"
CFG="/home/container/server.cfg"
RPT_DIR="/home/container/serverprofile/rpt"

if [ "${UPDATE_SERVER:-1}" = "1" ]; then
    if [ -z "${STEAM_USER:-}" ] || [ "${STEAM_USER}" = "anonymous" ]; then
        log "WARN: Arma 3's server depot needs a Steam account that owns the game; STEAM_USER is unset."
    fi
    pterohost_steam_update "${APPID}" "${SRCDS_BETAID:-}" "${VALIDATE_SERVER:-0}" \
        "/home/container/${BINARY}" || true
else
    log "UPDATE_SERVER=0 - skipping SteamCMD."
    pterohost_steam_seed
    pterohost_steam_sdk
fi

if [ -f "${CFG}" ] && [ -n "${MAX_PLAYERS:-}" ]; then
    cp -a "${CFG}" "${CFG}.pterohost-orig" 2>/dev/null || true
    cfg_set "${CFG}" maxPlayers "${MAX_PLAYERS}"
fi

# The name in the public server list. Arma ships server.cfg with hostname
# commented out, and the egg had no field for it, so five of the six live
# servers were advertising the Bohemia default and the sixth had opened the file
# manager and typed one in. SERVER_HOSTNAME owns the key now; empty leaves the
# file alone, so that sixth server keeps its name.
if [ -f "${CFG}" ]; then
    cp -a "${CFG}" "${CFG}.pterohost-orig" 2>/dev/null || true
    cfg_set_owned "${CFG}" hostname "${SERVER_HOSTNAME:-}"
    if [ -n "${SERVER_HOSTNAME:-}" ]; then
        log "Server name: ${SERVER_HOSTNAME}"
    fi
fi

# ---------------------------------------------------------------------------
# Mods. Same contract as DayZ: the egg publishes MODIFICATIONS and MOD_FILE, the
# command line wants one -mod= list, and the workshop items behind it have to be
# on disk and current. 107410 is the Arma 3 game, which owns the workshop items.
# ---------------------------------------------------------------------------
CLIENT_MODS="$(pterohost_mods_client)"
ALL_MODS="$(pterohost_mods_dedupe "${CLIENT_MODS};${SERVERMODS:-}")"

if [ "${UPDATE_SERVER:-1}" = "1" ] && [ "${DISABLE_MOD_UPDATES:-0}" != "1" ]; then
    pterohost_workshop_sync "${GAME_ID:-107410}" "${ALL_MODS}"
elif [ -n "${ALL_MODS}" ]; then
    log "Mod updates disabled - using the copies already on disk."
fi

if [ "${MODS_LOWERCASE:-0}" = "1" ]; then
    log "MODS_LOWERCASE=1 - normalising mod file names."
    for mod in $(printf '%s' "${ALL_MODS}" | tr ';' ' '); do
        pterohost_mods_lowercase "/home/container/${mod}"
    done
fi

# Same defect as DayZ: an author who published meta.cpp with `publishedid = 0`
# makes the server advertise a mod with no workshop id, and the launcher then
# cannot offer the subscribe-and-join it exists for. Runs on every boot because
# the next mod update brings the author's zero straight back.
if [ -n "${ALL_MODS}" ]; then
    # shellcheck disable=SC2086
    pterohost_mods_fix_meta $(printf '%s' "${ALL_MODS}" | tr ';' ' ' | sed 's#[^ ][^ ]*#/home/container/&#g')
fi

# The base command, used only when the panel did not supply one (an egg that
# still reads "start-arma3" and nothing else).
args=(
    -ip="${SERVER_IP}"
    -port="${SERVER_PORT}"
    -profiles=./serverprofile
    -bepath=./
    -cfg=basic.cfg
    -config=server.cfg
)

pterohost_panel_argv "$@"

if [ "${PTEROHOST_FROM_PANEL}" = "1" ]; then
    # The egg names the stock binary; SERVER_BINARY can point somewhere else.
    pterohost_swap_binary ./arma3server_x64 "./${BINARY}"
else
    PTEROHOST_ARGS=("./${BINARY}" "${args[@]}")
fi

# Resolved above from MODIFICATIONS + MOD_FILE. The egg cannot carry this as a
# {{VAR}} in the startup line: half of it is parsed out of an uploaded HTML file.
if [ -n "${CLIENT_MODS}" ]; then
    pterohost_append_if_absent -mod "-mod=${CLIENT_MODS}"
    log "Client mods: ${CLIENT_MODS}"
fi
[ -n "${SERVERMODS:-}" ] && pterohost_append_if_absent -serverMod "-serverMod=${SERVERMODS}"

# A migrated egg carries {{STARTUP_PARAMS}} in the startup string itself.
if [ "${PTEROHOST_FROM_PANEL}" != "1" ] && [ -n "${STARTUP_PARAMS:-}" ]; then
    # shellcheck disable=SC2206
    PTEROHOST_ARGS+=(${STARTUP_PARAMS})
fi

# Headless clients. The egg has always published HC_NUM/HC_HIDE, but nothing
# read them, so a mission with an HC slot ran every AI on the server's one
# thread. Each HC is a second copy of the binary in client mode with the same
# mods. They start before the server and keep retrying until it accepts them;
# tini -g takes them down with the server.
#
# The server binds SERVER_IP, not loopback, so an HC connects from that address.
# Arma hands an HC slot only to an address in headlessClients[] (and lifts the
# bandwidth cap only for localClient[]), so that address goes into both.
HC_COUNT="${HC_NUM:-0}"
case "${HC_COUNT}" in ''|*[!0-9]*) HC_COUNT=0 ;; esac
if [ "${HC_COUNT}" -gt 0 ]; then
    HC_ADDR="${SERVER_IP:-127.0.0.1}"
    [ "${HC_ADDR}" = "0.0.0.0" ] && HC_ADDR=127.0.0.1
    if [ -f "${CFG}" ]; then
        for key in headlessClients localClient; do
            if grep -qE "^[[:space:]]*${key}\[\][[:space:]]*=" "${CFG}"; then
                if ! grep -E "^[[:space:]]*${key}\[\][[:space:]]*=" "${CFG}" | grep -qF "\"${HC_ADDR}\""; then
                    sed -i -E "s|^([[:space:]]*${key}\[\][[:space:]]*=[[:space:]]*\{)[[:space:]]*|\1 \"${HC_ADDR}\", |" "${CFG}"
                    sed -i -E "s|^([[:space:]]*${key}\[\][[:space:]]*=[[:space:]]*\{ \"${HC_ADDR}\"), [[:space:]]*\}|\1 }|" "${CFG}"
                fi
            else
                [ -n "$(tail -c1 "${CFG}")" ] && printf '\n' >> "${CFG}"
                printf '%s[] = { "127.0.0.1", "%s" };\n' "${key}" "${HC_ADDR}" >> "${CFG}"
            fi
        done
    fi
    HC_PASS="$(cfg_get "${CFG}" password 2>/dev/null | tr -d '"')"
    [ -z "${HC_PASS}" ] && HC_PASS="${SERVER_PASSWORD:-}"
    mkdir -p ./serverprofile
    for i in $(seq 1 "${HC_COUNT}"); do
        hc=("./${BINARY}" -client "-connect=${HC_ADDR}" "-port=${SERVER_PORT}"
            "-profiles=./serverprofile/hc${i}" "-name=HC${i}" -nosound)
        [ -n "${HC_PASS}" ] && hc+=("-password=${HC_PASS}")
        [ -n "${CLIENT_MODS}" ] && hc+=("-mod=${CLIENT_MODS}")
        if [ "${HC_HIDE:-1}" = "1" ]; then
            if pterohost_rpt_enabled && pterohost_rpt_open "${RPT_DIR}" "hc${i}" "binary=${BINARY} hc=${i}"; then
                ln -sfn "rpt/hc${i}-current.log" "./serverprofile/hc${i}.log" 2>/dev/null
                "${hc[@]}" > >(pterohost_rpt_file "${RPT_DIR}" "hc${i}") 2>&1 &
            else
                [ -L "./serverprofile/hc${i}.log" ] && rm -f "./serverprofile/hc${i}.log"
                "${hc[@]}" > "./serverprofile/hc${i}.log" 2>&1 &
            fi
        else
            "${hc[@]}" 2>&1 | sed -u "s/^/[HC${i}] /" &
        fi
        log "Headless client ${i} -> ${HC_ADDR}:${SERVER_PORT}"
    done
fi

log "Starting Arma 3 on ${SERVER_IP}:${SERVER_PORT} (query $((SERVER_PORT + 1)))."
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"

# Also kept in serverprofile/rpt/ (shared/rpt-tee.sh, ticket 4626): the
# console output survives the container, the server process and its exit code
# stay exactly as with a bare exec.
if pterohost_rpt_enabled; then
    log "Server log is also kept in serverprofile/rpt/arma3-current.log (RPT_LOG=0 turns this off)."
fi
pterohost_rpt_exec "${RPT_DIR}" arma3 "binary=${BINARY} mods=$(printf '%s' "${ALL_MODS}" | tr ';' '\n' | grep -c .)" \
    "${PTEROHOST_ARGS[@]}"
