#!/bin/bash
# Pterohost Project Zomboid dedicated-server bootstrap.
#
# What this fixes relative to running the stock parkervcp/steamcmd image:
#
# 1. THE HEAP. ProjectZomboid64 is an ELF launcher (pzexe), not a shell script,
#    and it takes its JVM arguments exclusively from ProjectZomboid64.json.
#    That file ships with a hardcoded "-Xmx8g" and no -Xms. So a 4 GB plan runs
#    a JVM that believes it may grow to 8 GB and gets OOM-killed by the cgroup,
#    while a 16 GB plan silently caps itself at 8. Passing -Xmx on the command
#    line does nothing, which is why the usual advice to edit start-server.sh
#    has no effect. We rewrite vmArgs from SERVER_MEMORY instead: -Xmx is the
#    plan and -Xms is 128 MB, the same arithmetic the Minecraft eggs use. -Xms
#    used to be pinned equal to -Xmx, which committed the whole plan on the
#    first second: the panel showed 84-96% memory before anyone joined and a
#    node carrying three 24 GB worlds ran out for real.
#
# 2. RCON. Project Zomboid answers A2S but its A2S_PLAYER response carries no
#    names, so the panel can only list players over RCON - and RCON is
#    configured solely in <server>.ini, which the panel does not template. We
#    write RCONPort/RCONPassword (and the ports) from the egg variables, and
#    leave every gameplay key the owner has tuned alone.
#
# 3. Graceful shutdown. Zomboid does read stdin, so "quit" saves the world
#    properly - but only if SIGTERM is turned into that command rather than
#    killing the JVM outright, AND only if something is still listening on the
#    console. The forwarder that carries it used to be a background job reading
#    plain stdin, which the shell hands /dev/null: it exited instantly, the
#    console was write-only, and every stop ran to the Wings timeout and ended
#    in SIGKILL with the world unsaved.
#
# Every step is non-fatal: a Steam or Workshop hiccup logs a warning and boots
# with the files already on disk.

set -u
cd /home/container || exit 1

# shellcheck source=/dev/null
. /usr/local/lib/pterohost/steam-update.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/kvconf.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/launch.sh

log() { pterohost_log "$@"; }

BINARY="./ProjectZomboid64"
APPID="${SRCDS_APPID:-380870}"
BRANCH="${SRCDS_BETAID:-}"
SERVER_NAME="${SERVER_NAME:-Pterodactyl}"
ZOMBOID_DIR="/home/container/.cache"

# ---------------------------------------------------------------------------
# 1. Update the server via anonymous SteamCMD.
# ---------------------------------------------------------------------------
if [ "${AUTO_UPDATE:-1}" = "1" ]; then
    pterohost_steam_update "${APPID}" "${BRANCH}" "${STEAM_VALIDATE:-0}" "/home/container/ProjectZomboid64" || true
else
    log "AUTO_UPDATE=0 - skipping SteamCMD, using existing server files."
    pterohost_steam_seed
    pterohost_steam_sdk
fi

# ---------------------------------------------------------------------------
# 2. JVM heap and GC, derived from the container's real memory limit.
# ---------------------------------------------------------------------------
JSON="/home/container/ProjectZomboid64.json"

# max_heap_mb
#   -Xmx, and nothing else, is what the customer bought. Wings gives the
#   container the plan plus a 5% overhead (docker.overhead.default_multiplier),
#   which is the room the JVM needs outside the heap - metaspace, code cache,
#   thread stacks, GC structures and the game's native libraries. That is the
#   same arithmetic the Minecraft eggs here have always used
#   (-Xms128M -Xmx{{SERVER_MEMORY}}M), so Zomboid now matches it.
max_heap_mb() {
    local limit="${SERVER_MEMORY:-0}"

    # Explicit override wins, for the rare server that needs hand-tuning.
    if [ -n "${ZOMBOID_MAX_HEAP_MB:-}" ]; then
        echo "${ZOMBOID_MAX_HEAP_MB}"
        return
    fi

    # Unlimited plans report 0; fall back to the vendor default rather than
    # handing the JVM the whole host.
    if [ "${limit}" -le 0 ] 2>/dev/null; then
        echo 8192
        return
    fi

    # ZOMBOID_HEAP_PCT stays as the dial for a server that turns out to need
    # more room outside the heap than the overhead provides.
    local pct="${ZOMBOID_HEAP_PCT:-100}"
    local heap=$(( limit * pct / 100 ))

    [ "${heap}" -lt 512 ] && heap=512

    echo "${heap}"
}

# min_heap_mb
#   The headline of this change. -Xms used to equal -Xmx, so the JVM committed
#   the entire plan on the first second and the panel showed a server sitting at
#   84-96% memory before a single player joined. Customers read that as "out of
#   RAM", and a node carrying three 24 GB Zomboid servers really did run out.
#   Starting small lets the heap grow with the world and lets ZGC hand the pages
#   back when it shrinks.
min_heap_mb() {
    local min="${ZOMBOID_MIN_HEAP_MB:-128}"
    local max="$1"

    [ "${min}" -lt 64 ] 2>/dev/null && min=64
    [ "${min}" -gt "${max}" ] 2>/dev/null && min="${max}"

    echo "${min}"
}

if [ -f "${JSON}" ] && command -v jq >/dev/null 2>&1; then
    HEAP_MB="$(max_heap_mb)"
    MIN_HEAP_MB="$(min_heap_mb "${HEAP_MB}")"
    GC="${ZOMBOID_GC:-zgc}"

    case "${GC}" in
        g1)
            # Community-favoured alternative: shorter, more frequent pauses.
            # G1 only gives memory back on a full GC, so with a small -Xms the
            # heap would ratchet up and never come down. The periodic collection
            # is what makes "grows with the world" true for G1 as well.
            gc_args='["-XX:+UseG1GC","-XX:MaxGCPauseMillis=50","-XX:G1PeriodicGCInterval=300000","-XX:G1PeriodicGCSystemLoadThreshold=0"]'
            ;;
        *)
            # Vendor default, and the better fit here: ZGC uncommits unused heap
            # on its own, so a quiet server returns memory to the node.
            gc_args='["-XX:+UseZGC"]'
            ;;
    esac

    if jq -e . "${JSON}" >/dev/null 2>&1; then
        [ -f "${JSON}.pterohost-orig" ] || cp -a "${JSON}" "${JSON}.pterohost-orig" 2>/dev/null || true

        tmp="$(mktemp)"
        jq --argjson heap "${HEAP_MB}" --argjson minheap "${MIN_HEAP_MB}" --argjson gc "${gc_args}" '
            .vmArgs = ([
                "-Djava.awt.headless=true",
                "-Xms\($minheap)m",
                "-Xmx\($heap)m",
                "-Dzomboid.steam=1",
                "-Dzomboid.znetlog=1",
                "-Djava.library.path=linux64/:natives/",
                "-Djava.security.egd=file:/dev/urandom",
                "-XX:-OmitStackTraceInFastThrow"
            ] + $gc)
        ' "${JSON}" > "${tmp}" 2>/dev/null \
            && cat "${tmp}" > "${JSON}" && rm -f "${tmp}" \
            && log "JVM heap: -Xms${MIN_HEAP_MB}m -Xmx${HEAP_MB}m (plan ${SERVER_MEMORY:-?}m, GC ${GC})." \
            || { rm -f "${tmp}"; log "WARN: could not rewrite ${JSON}; leaving vendor JVM args."; }
    else
        log "WARN: ${JSON} is not valid JSON; leaving it alone."
    fi
else
    log "WARN: ${JSON} not found yet - JVM heap stays at the vendor default until the next boot."
fi

# glibc allocates one arena per thread by default, which inflates RSS in a
# memory-capped container without buying throughput for this workload.
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"

# ---------------------------------------------------------------------------
# 3. Server ini: ports and RCON must agree with the panel's allocations.
# ---------------------------------------------------------------------------
INI="${ZOMBOID_DIR}/Server/${SERVER_NAME}.ini"
mkdir -p "${ZOMBOID_DIR}/Server"

if [ ! -f "${INI}" ]; then
    # First boot: the game has not written its config yet. Seed a minimal file;
    # Zomboid fills in every key it needs on startup.
    log "No ${SERVER_NAME}.ini yet - seeding one."
    : > "${INI}"
fi

kv_backup_once "${INI}" ports

kv_set "${INI}" DefaultPort "${SERVER_PORT}"
[ -n "${STEAM_PORT:-}" ] && kv_set "${INI}" UDPPort "${STEAM_PORT}"
kv_set "${INI}" PublicName "${SERVER_NAME}"
[ -n "${MAX_PLAYERS:-}" ] && kv_set "${INI}" MaxPlayers "${MAX_PLAYERS}"

# RCON is what gives the panel a player list. Only enable it when the egg
# actually allocated a port and set a password - never invent one, and never
# leave RCON listening with an empty password.
if [ -n "${RCON_PORT:-}" ] && [ -n "${RCON_PASSWORD:-}" ]; then
    kv_set "${INI}" RCONPort "${RCON_PORT}"
    kv_set "${INI}" RCONPassword "${RCON_PASSWORD}"
    log "RCON enabled on port ${RCON_PORT}."
else
    log "RCON not configured (RCON_PORT/RCON_PASSWORD unset) - player names will be unavailable in the panel."
fi

[ -n "${SERVER_PUBLIC:-}" ] && kv_set "${INI}" Public "${SERVER_PUBLIC}"
[ -n "${SERVER_PASSWORD:-}" ] && kv_set "${INI}" Password "${SERVER_PASSWORD}"

# ---------------------------------------------------------------------------
# 4. Launch, forwarding console input and turning SIGTERM into a clean save.
# ---------------------------------------------------------------------------
export PATH="./jre64/bin:${PATH}"
export LD_LIBRARY_PATH="./linux64:./natives:.:./jre64/lib/amd64:${LD_LIBRARY_PATH:-}"

# libjsig lets the JVM chain signal handlers instead of the game's native libs
# stealing them. It ships inside the bundled JRE, so only preload it once the
# game files are actually present - otherwise every boot before the first
# SteamCMD run prints an ld.so preload error.
if [ -f "/home/container/jre64/lib/amd64/libjsig.so" ] || [ -f "/home/container/jre64/lib/libjsig.so" ]; then
    export LD_PRELOAD="${LD_PRELOAD:+${LD_PRELOAD}:}libjsig.so"
fi

CHILD=""

# The game's stdin comes through a FIFO rather than straight from Wings, so the
# signal handler has somewhere to write "quit" to. Writing to /proc/PID/fd/0
# would be the obvious shortcut but is unreliable when that fd is a pipe.
FIFO="/tmp/zomboid-stdin.$$"
mkfifo "${FIFO}" 2>/dev/null || true
# Open read-write on our own end so the FIFO never reports EOF to the game when
# no writer happens to be attached.
exec 3<>"${FIFO}"

# Wings' end of the console, kept on its own descriptor. The forwarder below
# runs as a background job, and the shell gives a background job /dev/null for
# stdin unless it is redirected explicitly - so the previous "while read; done &"
# saw EOF and exited instantly. Nothing typed in the panel console ever reached
# the game, and the egg's "quit" stop command was swallowed with it: every stop
# ran to the Wings timeout and ended in SIGKILL, with the world unsaved.
exec 4<&0

graceful_stop() {
    if [ -z "${CHILD}" ] || ! kill -0 "${CHILD}" 2>/dev/null; then
        return
    fi

    log "Stop requested - sending 'quit' so the world is saved."
    printf 'quit\n' >&3

    # A large world takes a while to write out. Escalating early is how save
    # corruption happens, so wait it out first.
    for _ in $(seq 1 "${ZOMBOID_STOP_TIMEOUT:-90}"); do
        kill -0 "${CHILD}" 2>/dev/null || { log "Server exited cleanly."; return; }
        sleep 1
    done

    log "Still running after ${ZOMBOID_STOP_TIMEOUT:-90}s - escalating to SIGTERM."
    kill -TERM "${CHILD}" 2>/dev/null || true
}

trap graceful_stop SIGTERM SIGINT

# The base command, used only when the panel did not supply one (an egg that
# still reads "start-zomboid" and nothing else).
args=(
    -cachedir="${ZOMBOID_DIR}"
    -port "${SERVER_PORT}"
    -servername "${SERVER_NAME}"
    -adminusername "${ADMIN_USER:-admin}"
)

pterohost_panel_argv "$@"

if [ "${PTEROHOST_FROM_PANEL}" != "1" ]; then
    PTEROHOST_ARGS=("${BINARY}" "${args[@]}")
fi

[ -n "${STEAM_PORT:-}" ] && pterohost_append_if_absent -udpport -udpport "${STEAM_PORT}"

# Credentials stay out of the startup string: the panel renders it with the
# variable values substituted in.
[ -n "${ADMIN_PASSWORD:-}" ] && pterohost_append_if_absent -adminpassword -adminpassword "${ADMIN_PASSWORD}"

# A migrated egg carries {{ADDITIONAL_ARGS}} in the startup string itself.
if [ "${PTEROHOST_FROM_PANEL}" != "1" ] && [ -n "${ADDITIONAL_ARGS:-}" ]; then
    # Deliberately unquoted: ADDITIONAL_ARGS is a user-supplied argument list.
    # shellcheck disable=SC2206
    PTEROHOST_ARGS+=(${ADDITIONAL_ARGS})
fi

log "Starting Project Zomboid (port ${SERVER_PORT}, udp ${STEAM_PORT:-unset})."
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"

"${PTEROHOST_ARGS[@]}" <"${FIFO}" &
CHILD=$!

# Forward panel console input into the same FIFO, reading from the saved copy of
# stdin rather than from stdin itself - see the comment on `exec 4<&0` above.
forward_console() {
    local line
    while IFS= read -r line <&4; do
        printf '%s\n' "${line}" >&3
    done
}

forward_console &
FORWARDER=$!

wait "${CHILD}"
STATUS=$?

kill "${FORWARDER}" 2>/dev/null || true
exec 3>&-
exec 4<&-
rm -f "${FIFO}"

exit "${STATUS}"
