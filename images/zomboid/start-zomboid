#!/bin/bash
# Pterohost Project Zomboid dedicated-server bootstrap.
#
# What this fixes relative to running the stock parkervcp/steamcmd image:
#
# 1. THE HEAP. ProjectZomboid64 is an ELF launcher (pzexe), not a shell script,
#    and it takes its JVM arguments exclusively from ProjectZomboid64.json.
#    That file ships with a hardcoded "-Xmx8g" and no -Xms. So a 4 GB plan runs
#    a JVM that believes it may grow to 8 GB and gets OOM-killed by the cgroup,
#    while a 16 GB plan silently caps itself at 8. Passing -Xmx on the command
#    line does nothing, which is why the usual advice to edit start-server.sh
#    has no effect. We rewrite vmArgs from SERVER_MEMORY instead: -Xmx is the
#    plan and -Xms is 128 MB, the same arithmetic the Minecraft eggs use. -Xms
#    used to be pinned equal to -Xmx, which committed the whole plan on the
#    first second: the panel showed 84-96% memory before anyone joined and a
#    node carrying three 24 GB worlds ran out for real.
#
# 2. RCON. Project Zomboid answers A2S but its A2S_PLAYER response carries no
#    names, so the panel can only list players over RCON - and RCON is
#    configured solely in <server>.ini, which the panel does not template. We
#    write RCONPort/RCONPassword (and the ports) from the egg variables, and
#    leave every gameplay key the owner has tuned alone.
#
# 3. Graceful shutdown. Zomboid does read stdin, so "quit" saves the world
#    properly - but only if SIGTERM is turned into that command rather than
#    killing the JVM outright, AND only if something is still listening on the
#    console. The forwarder that carries it used to be a background job reading
#    plain stdin, which the shell hands /dev/null: it exited instantly, the
#    console was write-only, and every stop ran to the Wings timeout and ended
#    in SIGKILL with the world unsaved.
#
# 4. THE NAME PLAYERS SEE. -servername picks the config file and the save
#    folder, so it has to stay filename-safe and the egg validates it as
#    alpha_num. PublicName - the name in the in-game and Steam server browsers -
#    is a different key entirely, and this script used to overwrite it from
#    SERVER_NAME on every boot. The owner could therefore neither type their
#    real name in the panel nor keep one set by hand: an ini edit or an in-game
#    `changeoption PublicName` lasted until the next restart. SERVER_PUBLIC_NAME
#    and SERVER_DESCRIPTION now own those two keys, and when they are empty the
#    file is left alone rather than reset.
#
# 5. RENAMING THE SERVER USED TO DESTROY IT. The other half of the same split:
#    -servername does not only pick a filename, it picks the config, the sandbox
#    settings, the spawn files, the player database and the world directory, all
#    under that one name. So changing it in the panel renamed nothing - it
#    pointed the server at a name nothing existed under and the game built all
#    of it from scratch. The owner restarted into an empty map with no mods, no
#    settings and no players, while every byte of the real server sat on disk
#    under the old name where the panel could not see it. 14 of 62 live servers
#    were carrying worlds abandoned exactly that way, one of them 177 MB of
#    played game. Section 3 now moves the data to follow the name.
#
# 6. MOD ANIMATIONS ON A CASE-SENSITIVE FILESYSTEM. Build 42 finds an AnimSet
#    by its real name on disk but resolves the files it references through a
#    path it has lowercased end to end, so mods that ship media/AnimSets fail
#    to parse on Linux and only on Linux. The states they define are then never
#    registered and players get stuck animations and cancelled interactions,
#    with nothing in the log that names a mod. We mirror the names the loader
#    asks for, narrowly and repeatedly - full reasoning in section 4.
#
# Every step is non-fatal: a Steam or Workshop hiccup logs a warning and boots
# with the files already on disk.

set -u
cd /home/container || exit 1

# shellcheck source=/dev/null
. /usr/local/lib/pterohost/steam-update.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/kvconf.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/identity.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/launch.sh

log() { pterohost_log "$@"; }

BINARY="./ProjectZomboid64"
APPID="${SRCDS_APPID:-380870}"
BRANCH="${SRCDS_BETAID:-}"
SERVER_NAME="${SERVER_NAME:-Pterodactyl}"
ZOMBOID_DIR="/home/container/.cache"

# ---------------------------------------------------------------------------
# 1. Update the server via anonymous SteamCMD.
# ---------------------------------------------------------------------------
if [ "${AUTO_UPDATE:-1}" = "1" ]; then
    pterohost_steam_update "${APPID}" "${BRANCH}" "${STEAM_VALIDATE:-0}" "/home/container/ProjectZomboid64" || true
else
    log "AUTO_UPDATE=0 - skipping SteamCMD, using existing server files."
    pterohost_steam_seed
    pterohost_steam_sdk
fi

# ---------------------------------------------------------------------------
# 2. JVM heap and GC, derived from the container's real memory limit.
# ---------------------------------------------------------------------------
JSON="/home/container/ProjectZomboid64.json"

# max_heap_mb
#   -Xmx, and nothing else, is what the customer bought. Wings gives the
#   container the plan plus a 5% overhead (docker.overhead.default_multiplier),
#   which is the room the JVM needs outside the heap - metaspace, code cache,
#   thread stacks, GC structures and the game's native libraries. That is the
#   same arithmetic the Minecraft eggs here have always used
#   (-Xms128M -Xmx{{SERVER_MEMORY}}M), so Zomboid now matches it.
max_heap_mb() {
    local limit="${SERVER_MEMORY:-0}"

    # Explicit override wins, for the rare server that needs hand-tuning.
    if [ -n "${ZOMBOID_MAX_HEAP_MB:-}" ]; then
        echo "${ZOMBOID_MAX_HEAP_MB}"
        return
    fi

    # Unlimited plans report 0; fall back to the vendor default rather than
    # handing the JVM the whole host.
    if [ "${limit}" -le 0 ] 2>/dev/null; then
        echo 8192
        return
    fi

    # ZOMBOID_HEAP_PCT stays as the dial for a server that turns out to need
    # more room outside the heap than the overhead provides.
    local pct="${ZOMBOID_HEAP_PCT:-100}"
    local heap=$(( limit * pct / 100 ))

    [ "${heap}" -lt 512 ] && heap=512

    echo "${heap}"
}

# min_heap_mb
#   The headline of this change. -Xms used to equal -Xmx, so the JVM committed
#   the entire plan on the first second and the panel showed a server sitting at
#   84-96% memory before a single player joined. Customers read that as "out of
#   RAM", and a node carrying three 24 GB Zomboid servers really did run out.
#   Starting small lets the heap grow with the world, and the periodic GC the
#   collector below is configured with hands the pages back when it shrinks.
min_heap_mb() {
    local min="${ZOMBOID_MIN_HEAP_MB:-128}"
    local max="$1"

    [ "${min}" -lt 64 ] 2>/dev/null && min=64
    [ "${min}" -gt "${max}" ] 2>/dev/null && min="${max}"

    echo "${min}"
}

# jvm_tmpdir
#   Wings gives every container a 100 MB tmpfs on /tmp (docker.tmpfs_size), and
#   that is where the JVM puts java.io.tmpdir. TMPDIR is not consulted on Linux
#   - HotSpot hardcodes /tmp - so -Djava.io.tmpdir is the only way to move it.
#
#   Zomboid's startup backup builds its zip with commons-compress
#   ParallelScatterZipCreator, which deflates entries into scratch files under
#   java.io.tmpdir and only assembles the archive at the very end. Peak scratch
#   usage is therefore the size of the entire compressed backup, not of the
#   largest file in it. Service 7150 on node09 has a 2.1 GB save that
#   compresses to 144 MB: past the 100 MB mark the writes fail with
#   "No space left on device", ZipBackup swallows the exception, still logs
#   "Backup made in 560 ms" and leaves a 0-byte zip behind. That is the whole
#   failure mode - it is silent, and the server keeps booting normally. Six
#   servers across five nodes had been producing empty backups this way, the
#   last good one on each dating to whenever its world was still under 100 MB
#   compressed.
#
#   So point it at the volume: 200 GB of real disk instead of 100 MB of the
#   container's own RAM. Raising tmpfs_size would not be equivalent - tmpfs
#   pages are charged to the container's memory cgroup, so a bigger /tmp comes
#   straight out of the heap the customer paid for, and it would only move the
#   cliff rather than remove it as the world grows.
JVM_TMPDIR="/home/container/.tmp"

if mkdir -p "${JVM_TMPDIR}" 2>/dev/null && [ -w "${JVM_TMPDIR}" ]; then
    # commons-compress cleans up after itself, but a crash mid-backup leaves the
    # scratch files behind, and they count against the customer's disk quota.
    find "${JVM_TMPDIR}" -mindepth 1 -maxdepth 1 -mtime +1 -delete 2>/dev/null || true
else
    log "WARN: ${JVM_TMPDIR} is not writable - java.io.tmpdir stays on the 100 MB /tmp, backups over that size will fail."
    JVM_TMPDIR=""
fi

if [ -f "${JSON}" ] && command -v jq >/dev/null 2>&1; then
    HEAP_MB="$(max_heap_mb)"
    MIN_HEAP_MB="$(min_heap_mb "${HEAP_MB}")"
    GC="${ZOMBOID_GC:-g1}"

    case "${GC}" in
        zgc)
            # Opt-in only, and on Build 42 it is a trap. ZGC backs its heap with
            # a shared mapping, so the cgroup charges it as shmem rather than
            # anon - and it fills to the whole -Xmx within seconds of boot. The
            # small -Xms below does not slow that down, and ZGC's uncommit is
            # lazy (ZUncommitDelay, 300s by default), far too late to matter
            # while the server is still loading assets.
            #
            # Server 3765, a 6 GB plan on B42, measured under ZGC: shmem 5226 MB
            # against -Xmx5222m, 97% of the limit, and a repeating
            # "Memory cgroup out of memory: Killed process (ProjectZomboid6)".
            # Nothing appears in the game log - the JVM is gone before it can
            # write anything - so this reads as a silent boot loop: exit 137 and
            # wings reporting "detected server as entering a crashed state".
            #
            # Keep it for a server that measurably prefers ZGC's pause profile
            # and has heap headroom to spare.
            gc_args='["-XX:+UseZGC"]'
            ;;
        *)
            # Default. Shorter, more frequent pauses, and - the reason it is the
            # default - an ordinary anonymous heap that grows from -Xms with the
            # world instead of claiming the ceiling up front.
            #
            # G1 only gives memory back on a full GC, so with a small -Xms the
            # heap would ratchet up and never come down. The periodic collection
            # is what makes "grows with the world" true for G1 as well.
            #
            # Same server as above, after the switch: 2.8 GB of 6 GB (47%),
            # shmem down from 5226 MB to 4 MB, no OOM kill.
            gc_args='["-XX:+UseG1GC","-XX:MaxGCPauseMillis=50","-XX:G1PeriodicGCInterval=300000","-XX:G1PeriodicGCSystemLoadThreshold=0"]'
            ;;
    esac

    tmpdir_args='[]'
    if [ -n "${JVM_TMPDIR}" ]; then
        tmpdir_args="$(jq -nc --arg d "${JVM_TMPDIR}" '["-Djava.io.tmpdir=" + $d]')"
    fi

    if jq -e . "${JSON}" >/dev/null 2>&1; then
        [ -f "${JSON}.pterohost-orig" ] || cp -a "${JSON}" "${JSON}.pterohost-orig" 2>/dev/null || true

        tmp="$(mktemp)"
        jq --argjson heap "${HEAP_MB}" --argjson minheap "${MIN_HEAP_MB}" --argjson gc "${gc_args}" \
           --argjson tmpdir "${tmpdir_args}" '
            .vmArgs = ([
                "-Djava.awt.headless=true",
                "-Xms\($minheap)m",
                "-Xmx\($heap)m",
                "-Dzomboid.steam=1",
                "-Dzomboid.znetlog=1",
                "-Djava.library.path=linux64/:natives/",
                "-Djava.security.egd=file:/dev/urandom",
                "-XX:-OmitStackTraceInFastThrow"
            ] + $gc + $tmpdir)
        ' "${JSON}" > "${tmp}" 2>/dev/null \
            && cat "${tmp}" > "${JSON}" && rm -f "${tmp}" \
            && log "JVM heap: -Xms${MIN_HEAP_MB}m -Xmx${HEAP_MB}m (plan ${SERVER_MEMORY:-?}m, GC ${GC}); scratch ${JVM_TMPDIR:-/tmp}." \
            || { rm -f "${tmp}"; log "WARN: could not rewrite ${JSON}; leaving vendor JVM args."; }
    else
        log "WARN: ${JSON} is not valid JSON; leaving it alone."
    fi
else
    log "WARN: ${JSON} not found yet - JVM heap stays at the vendor default until the next boot."
fi

# glibc allocates one arena per thread by default, which inflates RSS in a
# memory-capped container without buying throughput for this workload.
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"

# ---------------------------------------------------------------------------
# 3. The world follows the name, then the ini agrees with the panel.
# ---------------------------------------------------------------------------
#
# Everything Zomboid keeps for a server is filed under -servername, so the panel
# field that looks like a display name is really the key to the owner's data.
# pterohost_ident_sync moves that data when the name changes; it never deletes,
# never overwrites, and refuses rather than half-finishing. See
# shared/identity.sh for the rules and the fleet damage that motivated them.
#
# This runs before anything below reads or seeds the ini, because on the first
# boot after a rename the migration is what puts the ini where the rest of this
# section expects to find it.
mkdir -p "${ZOMBOID_DIR}/Server"

(
    cd "${ZOMBOID_DIR}" || exit 0
    pterohost_ident_sync "/home/container/.pterohost-world-identity" "${SERVER_NAME}" \
        'Saves/Multiplayer/@' \
        'Server/@.ini' \
        'Server/@.ini.pterohost-orig' \
        'Server/@_SandboxVars.lua' \
        'Server/@_spawnpoints.lua' \
        'Server/@_spawnregions.lua' \
        'db/@.db'
)

INI="${ZOMBOID_DIR}/Server/${SERVER_NAME}.ini"

if [ ! -f "${INI}" ]; then
    # First boot: the game has not written its config yet. Seed a minimal file;
    # Zomboid fills in every key it needs on startup.
    log "No ${SERVER_NAME}.ini yet - seeding one."
    : > "${INI}"
fi

kv_backup_once "${INI}" ports

kv_set "${INI}" DefaultPort "${SERVER_PORT}"
[ -n "${STEAM_PORT:-}" ] && kv_set "${INI}" UDPPort "${STEAM_PORT}"
[ -n "${MAX_PLAYERS:-}" ] && kv_set "${INI}" MaxPlayers "${MAX_PLAYERS}"

# The name and the blurb in the in-game and Steam server browsers. SERVER_NAME
# is the fallback only, and only on a fresh install, so an existing server keeps
# whatever it is already advertising.
kv_set_owned "${INI}" PublicName "${SERVER_PUBLIC_NAME:-}" "${SERVER_NAME}"
kv_set_owned "${INI}" PublicDescription "${SERVER_DESCRIPTION:-}"

if [ -n "${SERVER_PUBLIC_NAME:-}" ]; then
    log "Public name: ${SERVER_PUBLIC_NAME}"
else
    log "Public name left to the server config ($(kv_get "${INI}" PublicName)); set it in the panel to manage it from there."
fi

# RCON is what gives the panel a player list. The port follows the allocation
# unconditionally - Zomboid opens the socket only once a password exists (with
# RCONPassword empty it does not listen at all, verified on the fleet), so
# writing the port on its own cannot expose anything, and it means the moment a
# password is set the server is already on the port the panel handed out rather
# than on the vendor default 27015.
[ -n "${RCON_PORT:-}" ] && kv_set "${INI}" RCONPort "${RCON_PORT}"

if [ -n "${RCON_PORT:-}" ] && [ -n "${RCON_PASSWORD:-}" ]; then
    kv_set "${INI}" RCONPassword "${RCON_PASSWORD}"
    log "RCON enabled on port ${RCON_PORT}."
else
    log "RCON not configured (RCON_PORT/RCON_PASSWORD unset) - player names will be unavailable in the panel."
fi

[ -n "${SERVER_PUBLIC:-}" ] && kv_set "${INI}" Public "${SERVER_PUBLIC}"
[ -n "${SERVER_PASSWORD:-}" ] && kv_set "${INI}" Password "${SERVER_PASSWORD}"

# ---------------------------------------------------------------------------
# 4. Workshop mods: make the lowercased paths the animation loader asks for
#    actually resolve on a case-sensitive filesystem.
# ---------------------------------------------------------------------------
#
# Build 42 loads a mod's animation states by walking media/AnimSets on disk with
# the name as the author wrote it, and then resolving every reference INSIDE
# those files through a path it has lowercased end to end. So a perfectly normal
# mod breaks on Linux and only on Linux:
#
#   Sapph_CookingWok.xml says   <animNode x_extends='looped.xml'>
#   the engine then opens       .../mods/sapphcookingb42/42.20.0/media/animsets/player/actions/looped.xml
#   the disk actually holds     .../mods/SapphCookingB42/42.20.0/media/AnimSets/player/actions/looped.xml
#
#   PZXmlParserException ... Caused by: java.io.FileNotFoundException
#     at zombie.core.skinnedmodel.advancedanimation.AnimNode.Parse(AnimNode.java:225)
#
# The AnimSet then does not parse, so its states are never registered. What the
# owner sees is not a stack trace - it is players stuck in animations and
# interactions that cancel themselves, because the server's action state machine
# is missing states the (Windows, case-insensitive) clients have. Measured on
# service 7474: 32 AnimSets failed to parse on every boot - 27 from Lifestyle:
# Hobbies, 5 from Sapph's Cooking - and the count went to zero once the
# lowercase paths existed. (Each failure writes three AnimNode.Parse lines, so
# the raw log line count is 96; the commit that introduced this quoted that
# number as the count of broken AnimSets, which it is not.)
#
# So mirror the names, and mirror them narrowly. Symlinks, not renames: the
# walker still opens the mixed-case spelling, so both have to work at once.
# Scope is the four media subtrees the engine opens by literal path, plus the
# mod and version directories above them, because the lowercased path the
# engine builds includes those components too. Deliberately NOT media/lua,
# media/ui, media/textures or media/maps: the mod file map is lowercased by the
# engine already (verified - a lua file present under four spellings on disk
# still logs exactly one "overrides" line), so links there buy nothing while
# making the server's tree differ from every client's, which is a bad trade with
# DoLuaChecksum on.
#
# Timing is the other half. The game downloads Workshop items itself, during its
# own startup, and only reads AnimSets about eighty seconds in - so a single
# pass before launch covers the mods already on disk and misses anything Steam
# rewrites during boot. Worse, an update REPLACES the directory and takes the
# links with it, which is how this silently regresses one restart later. Hence
# the watcher: re-mirror whenever the Workshop tree changes, for a bounded
# window, and prune the dangling links an update leaves behind.

ZOMBOID_WORKSHOP_APPID="${ZOMBOID_WORKSHOP_APPID:-108600}"
ZOMBOID_WORKSHOP_DIR="/home/container/steamapps/workshop/content/${ZOMBOID_WORKSHOP_APPID}"
ZOMBOID_CASE_MIRROR="${ZOMBOID_CASE_MIRROR:-1}"
ZOMBOID_CASE_MIRROR_WINDOW="${ZOMBOID_CASE_MIRROR_WINDOW:-600}"

# zomboid_case_roots
#   The directories worth mirroring: media/AnimSets, media/actiongroups,
#   media/anims_* and media/models_*, wherever a mod keeps its media - the
#   legacy layout (mods/<Mod>/media) and both Build 42 ones
#   (mods/<Mod>/common/media, mods/<Mod>/<version>/media).
#
#   -type d is load-bearing: it does not match symlinks, so a lowercase alias
#   created by an earlier pass is never mistaken for a second real directory.
zomboid_case_roots() {
    [ -d "${ZOMBOID_WORKSHOP_DIR}" ] || return 0

    find "${ZOMBOID_WORKSHOP_DIR}" -mindepth 3 -maxdepth 5 -type d -name media 2>/dev/null \
    | while IFS= read -r media; do
        find "${media}" -mindepth 1 -maxdepth 1 -type d \
            \( -iname 'AnimSets' -o -iname 'actiongroups' \
               -o -iname 'anims_*' -o -iname 'models_*' \) 2>/dev/null
    done
}

# zomboid_alias_lower <path>
#   Give <path> an all-lowercase sibling pointing at it. Relative target, so the
#   link survives the volume being moved between nodes. Succeeds only when it
#   actually created something, which is what the counters below count.
zomboid_alias_lower() {
    local path="$1"
    local dir name lower

    dir="$(dirname -- "${path}")"
    name="$(basename -- "${path}")"
    lower="$(printf '%s' "${name}" | tr '[:upper:]' '[:lower:]')"

    [ "${name}" = "${lower}" ] && return 1
    { [ -e "${dir}/${lower}" ] || [ -L "${dir}/${lower}" ]; } && return 1

    ln -s -- "${name}" "${dir}/${lower}" 2>/dev/null
}

# zomboid_alias_canonical <path>
#   The mirror above only ever adds lowercase names, which is all the loader
#   needs. The directory WALK is the other direction: it opens media/AnimSets
#   with that exact spelling, so a mod that shipped its folder as media/animsets
#   is never walked at all and its states are missing for a completely different
#   reason. Cheap to cover, and only for the three names where the engine's
#   spelling is not already lowercase.
zomboid_alias_canonical() {
    local path="$1"
    local dir name canon

    dir="$(dirname -- "${path}")"
    name="$(basename -- "${path}")"

    case "${name}" in
        animsets) canon="AnimSets" ;;
        anims_x)  canon="anims_X" ;;
        models_x) canon="models_X" ;;
        *)        return 1 ;;
    esac

    { [ -e "${dir}/${canon}" ] || [ -L "${dir}/${canon}" ]; } && return 1

    ln -s -- "${name}" "${dir}/${canon}" 2>/dev/null
}

# zomboid_mirror_case
#   One idempotent pass. Cheap enough to run repeatedly: it only walks the four
#   subtrees above, not the whole mod.
zomboid_mirror_case() {
    [ "${ZOMBOID_CASE_MIRROR}" = "1" ] || return 0
    [ -d "${ZOMBOID_WORKSHOP_DIR}" ] || return 0

    local created=0 pruned=0
    local root stale entry media modver mod ancestor

    while IFS= read -r root; do
        [ -n "${root}" ] || continue

        # A Workshop update replaces the directory under the links, so clear
        # what no longer points anywhere before adding more.
        while IFS= read -r stale; do
            [ -n "${stale}" ] || continue
            rm -f -- "${stale}" && pruned=$((pruned + 1))
        done < <(find "${root}" -xtype l 2>/dev/null)

        media="$(dirname -- "${root}")"
        modver="$(dirname -- "${media}")"
        mod="$(dirname -- "${modver}")"

        # The lowercased path the engine builds covers every component, so the
        # mod directory (and the version directory, when a mod capitalises it)
        # need aliases too. "mods" itself never does - skip it so the legacy
        # layout does not walk one level too far up.
        for ancestor in "${modver}" "${mod}"; do
            case "${ancestor}" in
                */mods) continue ;;
            esac
            zomboid_alias_lower "${ancestor}" && created=$((created + 1))
        done

        zomboid_alias_lower "${root}" && created=$((created + 1))
        zomboid_alias_canonical "${root}" && created=$((created + 1))

        while IFS= read -r entry; do
            [ -n "${entry}" ] || continue
            zomboid_alias_lower "${entry}" && created=$((created + 1))
        done < <(find "${root}" -depth -name '*[A-Z]*' -not -type l 2>/dev/null)
    done < <(zomboid_case_roots)

    printf '%s %s' "${created}" "${pruned}"
}

# zomboid_workshop_signature
#   Cheap "did Steam touch anything" probe - the ids and their mod directories,
#   with mtimes. A download or an update moves one of them.
zomboid_workshop_signature() {
    find "${ZOMBOID_WORKSHOP_DIR}" -maxdepth 3 -printf '%p %T@\n' 2>/dev/null | cksum
}

# zomboid_case_watch
#   Re-mirror while the game is still pulling Workshop items. Bounded, and the
#   launcher kills it once the server process is gone.
zomboid_case_watch() {
    local deadline=$(( SECONDS + ZOMBOID_CASE_MIRROR_WINDOW ))
    local last sig counts

    last="$(zomboid_workshop_signature)"

    while [ "${SECONDS}" -lt "${deadline}" ]; do
        sleep 10
        sig="$(zomboid_workshop_signature)"
        [ "${sig}" = "${last}" ] && continue
        last="${sig}"

        counts="$(zomboid_mirror_case)"
        case "${counts}" in
            "0 0"|"") ;;
            *) log "Workshop changed - case mirror: ${counts% *} link(s) added, ${counts#* } stale removed." ;;
        esac
    done
}

if [ "${ZOMBOID_CASE_MIRROR}" = "1" ]; then
    CASE_COUNTS="$(zomboid_mirror_case)"
    log "Animation path case mirror: ${CASE_COUNTS% *} link(s) added, ${CASE_COUNTS#* } stale removed."
else
    log "ZOMBOID_CASE_MIRROR=0 - mod animation paths left as-is (mixed-case AnimSets will not load on Linux)."
fi

# ---------------------------------------------------------------------------
# 5. Launch, forwarding console input and turning SIGTERM into a clean save.
# ---------------------------------------------------------------------------
export PATH="./jre64/bin:${PATH}"
export LD_LIBRARY_PATH="./linux64:./natives:.:./jre64/lib/amd64:${LD_LIBRARY_PATH:-}"

# libjsig lets the JVM chain signal handlers instead of the game's native libs
# stealing them. It ships inside the bundled JRE, so only preload it once the
# game files are actually present - otherwise every boot before the first
# SteamCMD run prints an ld.so preload error.
#
# Preload by ABSOLUTE path, and pick the path off disk rather than assuming one.
# The bundled JRE changed layout: B41 shipped jre64/lib/amd64/libjsig.so, and
# current builds ship a Zulu 25 JRE with jre64/lib/libjsig.so and no amd64
# directory at all. The guard here accepted both, but LD_LIBRARY_PATH below only
# ever named the amd64 one, so on every current build a bare "libjsig.so" was
# unresolvable and ld.so printed
#
#   ERROR: ld.so: object 'libjsig.so' from LD_PRELOAD cannot be preloaded ...
#
# once for each exec whose binary carries no RUNPATH into the JRE - that is the
# pzexe ELF launcher, twice per boot, on every Zomboid console. The JVM itself
# happened to resolve it anyway because jre64/bin/java does have that RUNPATH,
# which is why the preload still worked and only the noise was visible; an
# absolute path depends on neither LD_LIBRARY_PATH nor anybody's RUNPATH.
ZOMBOID_JRE_DIR="/home/container/jre64"
ZOMBOID_JSIG=""
for _jsig_candidate in "${ZOMBOID_JRE_DIR}/lib/amd64/libjsig.so" \
                       "${ZOMBOID_JRE_DIR}/lib/libjsig.so" \
                       "${ZOMBOID_JRE_DIR}/lib/server/libjsig.so"; do
    if [ -f "${_jsig_candidate}" ]; then
        ZOMBOID_JSIG="${_jsig_candidate}"
        break
    fi
done
unset _jsig_candidate
if [ -n "${ZOMBOID_JSIG}" ]; then
    export LD_PRELOAD="${LD_PRELOAD:+${LD_PRELOAD}:}${ZOMBOID_JSIG}"
fi

CHILD=""

# The game's stdin comes through a FIFO rather than straight from Wings, so the
# signal handler has somewhere to write "quit" to. Writing to /proc/PID/fd/0
# would be the obvious shortcut but is unreliable when that fd is a pipe.
FIFO="/tmp/zomboid-stdin.$$"
mkfifo "${FIFO}" 2>/dev/null || true
# Open read-write on our own end so the FIFO never reports EOF to the game when
# no writer happens to be attached.
exec 3<>"${FIFO}"

# Wings' end of the console, kept on its own descriptor. The forwarder below
# runs as a background job, and the shell gives a background job /dev/null for
# stdin unless it is redirected explicitly - so the previous "while read; done &"
# saw EOF and exited instantly. Nothing typed in the panel console ever reached
# the game, and the egg's "quit" stop command was swallowed with it: every stop
# ran to the Wings timeout and ended in SIGKILL, with the world unsaved.
exec 4<&0

graceful_stop() {
    if [ -z "${CHILD}" ] || ! kill -0 "${CHILD}" 2>/dev/null; then
        return
    fi

    log "Stop requested - sending 'quit' so the world is saved."
    printf 'quit\n' >&3

    # A large world takes a while to write out. Escalating early is how save
    # corruption happens, so wait it out first.
    for _ in $(seq 1 "${ZOMBOID_STOP_TIMEOUT:-90}"); do
        kill -0 "${CHILD}" 2>/dev/null || { log "Server exited cleanly."; return; }
        sleep 1
    done

    log "Still running after ${ZOMBOID_STOP_TIMEOUT:-90}s - escalating to SIGTERM."
    kill -TERM "${CHILD}" 2>/dev/null || true
}

trap graceful_stop SIGTERM SIGINT

# The base command, used only when the panel did not supply one (an egg that
# still reads "start-zomboid" and nothing else).
args=(
    -cachedir="${ZOMBOID_DIR}"
    -port "${SERVER_PORT}"
    -servername "${SERVER_NAME}"
    -adminusername "${ADMIN_USER:-admin}"
)

pterohost_panel_argv "$@"

if [ "${PTEROHOST_FROM_PANEL}" != "1" ]; then
    PTEROHOST_ARGS=("${BINARY}" "${args[@]}")
fi

[ -n "${STEAM_PORT:-}" ] && pterohost_append_if_absent -udpport -udpport "${STEAM_PORT}"

# Credentials stay out of the startup string: the panel renders it with the
# variable values substituted in.
[ -n "${ADMIN_PASSWORD:-}" ] && pterohost_append_if_absent -adminpassword -adminpassword "${ADMIN_PASSWORD}"

# A migrated egg carries {{ADDITIONAL_ARGS}} in the startup string itself.
if [ "${PTEROHOST_FROM_PANEL}" != "1" ] && [ -n "${ADDITIONAL_ARGS:-}" ]; then
    # Deliberately unquoted: ADDITIONAL_ARGS is a user-supplied argument list.
    # shellcheck disable=SC2206
    PTEROHOST_ARGS+=(${ADDITIONAL_ARGS})
fi

log "Starting Project Zomboid (port ${SERVER_PORT}, udp ${STEAM_PORT:-unset})."
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"

"${PTEROHOST_ARGS[@]}" <"${FIFO}" &
CHILD=$!

# Forward panel console input into the same FIFO, reading from the saved copy of
# stdin rather than from stdin itself - see the comment on `exec 4<&0` above.
forward_console() {
    local line
    while IFS= read -r line <&4; do
        printf '%s\n' "${line}" >&3
    done
}

forward_console &
FORWARDER=$!

# The game downloads its Workshop items after this point, so the pre-launch
# mirror pass cannot have seen them. Keep re-mirroring until the tree stops
# moving or the window closes - see section 4.
WATCHER=""
if [ "${ZOMBOID_CASE_MIRROR}" = "1" ]; then
    zomboid_case_watch &
    WATCHER=$!
fi

wait "${CHILD}"
STATUS=$?

[ -n "${WATCHER}" ] && kill "${WATCHER}" 2>/dev/null
kill "${FORWARDER}" 2>/dev/null || true
exec 3>&-
exec 4<&-
rm -f "${FIFO}"

exit "${STATUS}"
