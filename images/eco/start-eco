#!/bin/bash
# Eco: выделенный сервер.
#
# Порт и веб-порт задаются только файлом Configs/Network.eco - командную строку
# сервер не слушает. Файл принадлежит владельцу сервера, поэтому образ правит в
# нём ровно те ключи, что пришли переменными, и не трогает остальные.
#
# Остановка: по вики разработчиков мир сохраняется при SIGTERM, а SIGINT
# завершает процесс без сохранения. Wings шлёт именно TERM, поэтому специальной
# обработки не нужно - важно лишь не превращать его в другой сигнал.

set -u
cd /home/container || exit 1

. /usr/local/lib/pterohost/steam-update.sh
. /usr/local/lib/pterohost/launch.sh
. /usr/local/lib/pterohost/jsonconf.sh

APPID="${SRCDS_APPID:-739590}"
CONFIG_DIR="/home/container/Configs"
NETWORK="${CONFIG_DIR}/Network.eco"

pterohost_steam_update "${APPID}" "${SRCDS_BETAID:-}" "${VALIDATE:-0}" "/home/container/EcoServer" || true
chmod +x /home/container/EcoServer 2>/dev/null

# Ключ, значение которого задаёт панель. Пустая переменная означает сервер,
# созданный до появления этой настройки: там значение остаётся за владельцем.
eco_set() {
    [ -n "$2" ] || return 0
    json_set "$NETWORK" "$1" "$2"
}

# То же для ключей строкового типа.
eco_set_string() {
    [ -n "$2" ] || return 0
    json_set "$NETWORK" "$1" "$(json_string "$2")"
}

eco_config() {
    mkdir -p "$CONFIG_DIR" "${DOTNET_BUNDLE_EXTRACT_BASE_DIR:-/home/container/.dotnet_bundle}"

    # На первом запуске сервер ещё не развернул Configs/*.eco: рядом лежат
    # только шаблоны из депота. Берём шаблон - так набор ключей совпадает с тем,
    # что ждёт текущая версия игры, и наш файл не расходится с ней.
    if [ ! -f "$NETWORK" ] && [ -f "${NETWORK}.template" ]; then
        pterohost_log "создаю Configs/Network.eco из шаблона сервера"
        cp "${NETWORK}.template" "$NETWORK"
    fi
    [ -f "$NETWORK" ] || return 0

    eco_set GameServerPort "${SERVER_PORT:-}"
    eco_set WebServerPort "${WEB_PORT:-}"
    eco_set RconServerPort "${RCON_PORT:-}"
    eco_set SteamServerPort "${STEAM_PORT:-}"
    eco_set_string Name "${SERVER_NAME:-}"
    eco_set PublicServer "${PUBLIC_SERVER:-}"

    # Слоты: в Eco 11 MaxConnections переименован в DefaultSlots. ReservedSlots
    # не добавляет мест, а откусывает их от лимита под игроков с приоритетом,
    # поэтому дефолтные 5 на тарифе с 4 слотами закрыли бы вход вообще всем.
    eco_set DefaultSlots "${MAX_PLAYERS:-}"
    eco_set ReservedSlots "${RESERVED_SLOTS:-}"

    # Пароль и описание обязаны уметь обнуляться: очистил поле в панели -
    # значит хочет сервер без пароля, а не старое значение навсегда.
    json_set "$NETWORK" Password "$(json_string "${SERVER_PASSWORD:-}")"
    json_set "$NETWORK" DetailedDescription "$(json_string "${SERVER_DESC:-}")"

    # Порты уже выданы аллокацией, а контейнер работает в host-сети: пробивать
    # их ещё и через UPnP нечем и незачем.
    json_set "$NETWORK" UPnPEnabled false
}

eco_config

pterohost_panel_argv "$@"
if [ "${PTEROHOST_FROM_PANEL}" != "1" ]; then
    PTEROHOST_ARGS=(/home/container/EcoServer -nogui)
fi

# Eco требует авторизации в сервисе разработчиков: без неё сервер не стартует
# вовсе, а падает с «Authentication to Strange Cloud failed». Учётные данные -
# владельца сервера, как ключ BeamMP или токен Factorio. Если их нет, поднимаем
# сервер в офлайн-режиме и говорим об этом прямо, а не падаем молча.
#
# Значение крепится к флагу через "=": разбор аргументов у Eco другой формы не
# понимает и отвечает «Argument 'username' has to be passed with a value using
# the following format: -username="value"», после чего сервер падает.
if [ -n "${ECO_TOKEN:-}" ]; then
    pterohost_append_if_absent -userToken "-userToken=${ECO_TOKEN}"
elif [ -n "${ECO_USER:-}" ] && [ -n "${ECO_PASSWORD:-}" ]; then
    pterohost_append_if_absent -username "-username=${ECO_USER}"
    pterohost_append_if_absent -password "-password=${ECO_PASSWORD}"
else
    pterohost_log "нет учётных данных Eco - сервер поднимается в офлайн-режиме и не попадёт в общий список"
    pterohost_append_if_absent -offline -offline
fi

pterohost_prune_empty_args "${PTEROHOST_ARGS[@]}"
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"
exec "${PTEROHOST_ARGS[@]}"
