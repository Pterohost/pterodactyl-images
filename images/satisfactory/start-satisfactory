#!/bin/bash
# Pterohost Satisfactory bootstrap.
#
# Satisfactory answers no Valve A2S. Its state comes from two interfaces on the
# game port: a UDP "Lightweight Query" packet (no auth, always on) and an HTTPS
# API that needs a token. The panel speaks both, so nothing has to be enabled
# here - but -multihome must bind all interfaces or the UDP probe never reaches
# the container.
#
# Two things about the ports, both of which have cost a customer their server.
#
# 1. -ReliablePort MUST NOT equal the game port. The game binds the net driver
#    there first, the reliable-messaging socket then cannot have it, and the
#    server fails with NetDriverCreateFailure and loops back to the main menu
#    for ever. Server 3763 was handed a RELIABLE_PORT equal to its allocation
#    and spent eleven days doing exactly that - 34907 "Failed to bind server
#    streaming socket to explicitly defined port no 16004" and 78192
#    NetDriverCreateFailure in a 144 MB log - with the variable marked
#    user_editable=0, so its owner could not have fixed it even knowing why.
#
# 2. The server's NAME and ADMIN PASSWORD live in ServerSettings.<port>.sav,
#    keyed by the game port. Move a server to a different allocation and the
#    game silently starts from a blank one: no name, and unclaimed, so the owner
#    has to set an admin password again to get back in. 7 of the 11 live servers
#    carry an orphaned ServerSettings file from exactly that; one carries three.
#    The panel cannot write the name into this file - it is a length-prefixed
#    GVAS StrProperty next to a 2 KB X.509 blob, and the game is its only
#    author - but it can carry the file across when the port changes.

set -u
cd /home/container || exit 1

# shellcheck source=/dev/null
. /usr/local/lib/pterohost/steam-update.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/launch.sh

log() { pterohost_log "$@"; }

APPID="${SRCDS_APPID:-1690800}"

if [ "${AUTO_UPDATE:-1}" = "1" ]; then
    pterohost_steam_update "${APPID}" "${SRCDS_BETAID:-}" "${VALIDATE:-0}" \
        "/home/container/FactoryServer.sh" || true
else
    log "AUTO_UPDATE=0 - skipping SteamCMD."
    pterohost_steam_seed
    pterohost_steam_sdk
fi

export LD_LIBRARY_PATH="/home/container/linux64:${LD_LIBRARY_PATH:-}"

# The base command, used only when the panel did not supply one (an egg that
# still reads "start-satisfactory" and nothing else).
args=(
    FactoryGame
    -Port="${SERVER_PORT}"
    -multihome=0.0.0.0
    -unattended
)

# Satisfactory 1.0 ships FactoryServer.sh; older builds only had the Engine
# binary. Prefer the wrapper when it exists - it sets up the Steam SDK paths.
BINARY=""
if [ -x ./FactoryServer.sh ]; then
    BINARY="./FactoryServer.sh"
else
    BINARY="$(ls ./Engine/Binaries/Linux/*-Linux-Shipping 2>/dev/null | head -1)"
fi

if [ -z "${BINARY}" ] || [ ! -x "${BINARY}" ]; then
    log "ERROR: no Satisfactory server binary found - the install may be incomplete."
    exit 1
fi

pterohost_panel_argv "$@"

if [ "${PTEROHOST_FROM_PANEL}" = "1" ]; then
    # The egg names FactoryServer.sh; a pre-1.0 install only has the Engine one.
    pterohost_swap_binary ./FactoryServer.sh "${BINARY}"
else
    PTEROHOST_ARGS=("${BINARY}" "${args[@]}")
fi

if [ -z "${RELIABLE_PORT:-}" ]; then
    :
elif [ "${RELIABLE_PORT}" = "${SERVER_PORT}" ]; then
    log "WARN: the reliable port (${RELIABLE_PORT}) is the same as the game port, which the game cannot do - dropping it and letting the game choose. Give this server a second allocation and set it there."
else
    pterohost_append_if_absent -ReliablePort "-ReliablePort=${RELIABLE_PORT}"
fi

# Carry the server name and the admin password across a port change. This only
# ever creates a settings file that is missing or has never been claimed; a
# server sitting on a stable port is never touched, and no world save is
# involved - those live under SaveGames/server/ and are not keyed by port.
SF_SAVE_DIR="/home/container/.config/Epic/FactoryGame/Saved/SaveGames"
SF_SETTINGS="${SF_SAVE_DIR}/ServerSettings.${SERVER_PORT}.sav"
if [ -d "${SF_SAVE_DIR}" ] && ! grep -qa ServerName "${SF_SETTINGS}" 2>/dev/null; then
    for candidate in "${SF_SAVE_DIR}"/ServerSettings.*.sav; do
        [ -f "${candidate}" ] || continue
        [ "${candidate}" = "${SF_SETTINGS}" ] && continue
        grep -qa ServerName "${candidate}" || continue
        if cp -a "${candidate}" "${SF_SETTINGS}" 2>/dev/null; then
            log "The game port changed, so the server name and admin password were carried over from $(basename "${candidate}") - you do not have to claim the server again."
        fi
        break
    done
fi

# A migrated egg carries {{ADDITIONAL_ARGS}} in the startup string itself.
if [ "${PTEROHOST_FROM_PANEL}" != "1" ] && [ -n "${ADDITIONAL_ARGS:-}" ]; then
    # shellcheck disable=SC2206
    PTEROHOST_ARGS+=(${ADDITIONAL_ARGS})
fi

CHILD=""

# Satisfactory saves on SIGINT; a plain TERM drops the session.
graceful_stop() {
    [ -n "${CHILD}" ] && kill -0 "${CHILD}" 2>/dev/null || return

    log "Stop requested - sending SIGINT so the save completes."
    kill -INT "${CHILD}" 2>/dev/null || true

    for _ in $(seq 1 "${SATISFACTORY_STOP_TIMEOUT:-90}"); do
        kill -0 "${CHILD}" 2>/dev/null || { log "Server exited cleanly."; return; }
        sleep 1
    done

    kill -TERM "${CHILD}" 2>/dev/null || true
}

trap graceful_stop SIGTERM SIGINT

log "Starting Satisfactory on port ${SERVER_PORT} (reliable ${RELIABLE_PORT:-unset})."
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"

"${PTEROHOST_ARGS[@]}" &
CHILD=$!
wait "${CHILD}"
