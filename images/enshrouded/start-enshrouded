#!/bin/bash
# Pterohost Enshrouded bootstrap - the Windows dedicated server under GE-Proton.
#
#   1. Update. SteamCMD with the Windows platform forced (AUTO_UPDATE=1, the
#      default), the same shared helper every Steam image uses.
#   2. Config. enshrouded_server.json is created with the allocated port when
#      it is missing; the egg's config parser keeps name, slots and passwords
#      in step on every start. An existing file is never rewritten here.
#   3. Launch. `proton runinprefix` runs the exe directly in the prefix, so the
#      server's stdin and exit code stay attached to this script. No display
#      server: the dedicated server opens no window.
#   4. Console. Under runinprefix the server's own console output reaches the
#      panel directly, including the egg's "HostOnline" start marker; its log
#      file is not followed as well, which would print every line twice.
#   5. Stop. Wings' stop signal reaches only this script (tini without -g).
#      It is passed to the game as Ctrl+C, which makes the server save and exit;
#      the script waits for that, and only after ENS_STOP_TIMEOUT kills the
#      prefix outright.

set -u
cd /home/container || exit 1

# shellcheck source=/dev/null
. /usr/local/lib/pterohost/steam-update.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/launch.sh

log() { pterohost_log "$@"; }

APPID="${SRCDS_APPID:-2278520}"
BINARY="./enshrouded_server.exe"
CONFIG="./enshrouded_server.json"

# ens_default_config <port> <name> <slots>
#   Prints a minimal server config; the game fills in everything else on its
#   first start.
ens_default_config() {
    jq -n --argjson port "$1" --arg name "$2" --argjson slots "$3" '{
        name: $name,
        saveDirectory: "./savegame",
        logDirectory: "./logs",
        ip: "0.0.0.0",
        queryPort: $port,
        slotCount: $slots
    }'
}

# ens_game_pid
#   The wine process of the server itself. Matched on the process name, which
#   wine sets from the exe (truncated to 15 characters) - a command-line match
#   would also hit this script, whose arguments name the exe too.
ens_game_pid() {
    pgrep -n '^enshrouded_ser' 2>/dev/null
}

# Sourced by the test: functions only.
[ "${ENS_SOURCE_ONLY:-0}" = "1" ] && return 0 2>/dev/null

pterohost_steam_seed
if [ "${AUTO_UPDATE:-1}" = "1" ]; then
    STEAMCMD_PLATFORM=windows pterohost_steam_update "${APPID}" "${SRCDS_BETAID:-}" "${VALIDATE:-0}" "${BINARY}" || true
fi
# Proton's Steam bridge loads $HOME/.steam/sdk64/steamclient.so and aborts the
# server with an assertion when it is missing. SteamCMD downloads that library
# on its first run, so a volume that never ran it gets one bare run here.
pterohost_steam_sdk
if [ ! -e "${HOME}/.steam/sdk64/steamclient.so" ]; then
    log "Fetching the Steam client library..."
    "${STEAMCMD_RUN}/steamcmd.sh" +quit >/dev/null 2>&1 || true
    pterohost_steam_sdk
fi
if [ ! -f "${BINARY}" ]; then
    log "ERROR: ${BINARY} is missing - reinstall the server from the panel."
    exit 1
fi

if [ ! -s "${CONFIG}" ]; then
    ens_default_config "${SERVER_PORT:-15637}" "${SRV_NAME:-Enshrouded Server}" "${MAX_PLAYERS:-16}" > "${CONFIG}"
    log "Created ${CONFIG} for port ${SERVER_PORT:-15637}."
fi

export STEAM_COMPAT_DATA_PATH="/home/container/.proton"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="/home/container/.steam"
export WINEPREFIX="${STEAM_COMPAT_DATA_PATH}/pfx"
mkdir -p "${STEAM_COMPAT_DATA_PATH}" "${STEAM_COMPAT_CLIENT_INSTALL_PATH}" ./logs

pterohost_panel_argv "$@"
[ "${PTEROHOST_FROM_PANEL}" = "1" ] || PTEROHOST_ARGS=("${BINARY}")

CHILD=""
stopping=0

graceful_stop() {
    [ "${stopping}" = "0" ] || return 0
    stopping=1
    [ -n "${CHILD}" ] && kill -0 "${CHILD}" 2>/dev/null || return 0
    local game waited=0 limit="${ENS_STOP_TIMEOUT:-25}"
    game="$(ens_game_pid)"
    log "Stop requested - asking the server to save and exit."
    if [ -n "${game}" ]; then
        kill -INT "${game}" 2>/dev/null || true
    else
        kill -INT "${CHILD}" 2>/dev/null || true
    fi
    while [ "${waited}" -lt "${limit}" ]; do
        kill -0 "${CHILD}" 2>/dev/null || return 0
        sleep 1
        waited=$((waited + 1))
    done
    log "WARN: still running after ${limit}s - stopping the prefix."
    "${PROTON_DIR}/files/bin/wineserver" -k 2>/dev/null || true
}
trap graceful_stop SIGTERM SIGINT

log "Starting Enshrouded on port ${SERVER_PORT:-?} under GE-Proton."
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"

proton runinprefix "${PTEROHOST_ARGS[@]}" &
CHILD=$!

# wait returns early when a trapped signal arrives; keep waiting for the exit,
# then collect the server's own exit code rather than the interrupted wait's.
while :; do
    wait "${CHILD}"
    STATUS=$?
    kill -0 "${CHILD}" 2>/dev/null || break
done
if [ "${stopping}" = "1" ]; then
    wait "${CHILD}" 2>/dev/null
    rc=$?
    [ "${rc}" -ne 127 ] && STATUS=${rc}
fi
"${PROTON_DIR}/files/bin/wineserver" -w 2>/dev/null || true
exit "${STATUS:-0}"
