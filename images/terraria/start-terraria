#!/bin/bash
# Terraria: ванильный сервер, TShock и tModLoader одним образом.
#
# Ядро выбирается переменной TERRARIA_CORE, а не отдельным egg на каждое:
# владелец сервера переключает vanilla / tshock / tmodloader в панели и
# перезапускается, не заказывая новую услугу и не теряя миры - они лежат в
# saves/Worlds и общие для всех трёх ядер.
#
# Источники обновлений разные, поэтому и правила разные:
#   vanilla     - terraria.org отдаёт архив по номеру версии, «последней»
#                 ссылки у них нет. Версия задаётся явно (TERRARIA_VERSION),
#                 апстримный egg скрёб gamepedia.com, который переехал, и
#                 установка на нём сегодня падает.
#   tshock      - релизы на GitHub, ассет linux-x64.
#   tmodloader  - релизы на GitHub, ассет tModLoader.zip, собран под .NET 8,
#                 который уже есть в образе.
#
# Команда запуска живёт в egg (контракт shared/launch.sh), здесь - установка
# ядра, генерация serverconfig.txt и то, что статической строкой не выразить.

set -u
cd /home/container || exit 1

. /usr/local/lib/pterohost/launch.sh

TERRARIA_CORE="${TERRARIA_CORE:-vanilla}"
TERRARIA_VERSION="${TERRARIA_VERSION:-1456}"
TSHOCK_VERSION="${TSHOCK_VERSION:-latest}"
TMODLOADER_VERSION="${TMODLOADER_VERSION:-latest}"
WORLD_NAME="${WORLD_NAME:-world}"
WORLD_SIZE="${WORLD_SIZE:-1}"
WORLD_DIFFICULTY="${WORLD_DIFFICULTY:-0}"
MAX_PLAYERS="${MAX_PLAYERS:-8}"
SERVER_MOTD="${SERVER_MOTD:-}"
SERVER_PASSWORD="${SERVER_PASSWORD:-}"
WORLD_DIR="/home/container/saves/Worlds"

terraria_github_asset() {
    local repo="$1" pattern="$2" tag="${3:-latest}"
    local api="https://api.github.com/repos/${repo}/releases/${tag}"
    [ "$tag" != "latest" ] && api="https://api.github.com/repos/${repo}/releases/tags/${tag}"

    curl -fsSL "$api" 2>/dev/null \
        | grep -o '"browser_download_url": *"[^"]*"' \
        | cut -d'"' -f4 \
        | grep -Ei "$pattern" \
        | head -n 1
}

# Ванильный сервер: собственный ELF, рантайм ему не нужен.
terraria_install_vanilla() {
    [ -f /home/container/TerrariaServer.bin.x86_64 ] \
        && [ -f "/home/container/.terraria-${TERRARIA_VERSION}" ] && return 0

    local url="https://terraria.org/api/download/pc-dedicated-server/terraria-server-${TERRARIA_VERSION}.zip"
    pterohost_log "установка Terraria ${TERRARIA_VERSION}"
    local tmp="/home/container/.terraria-tmp"
    rm -rf "$tmp" && mkdir -p "$tmp"
    if ! curl -fsSL "$url" -o "$tmp/server.zip"; then
        pterohost_log "не скачался $url - проверьте TERRARIA_VERSION"
        rm -rf "$tmp"
        return 1
    fi

    unzip -oq "$tmp/server.zip" -d "$tmp" || true
    local linux
    linux="$(find "$tmp" -type d -name Linux | head -n 1)"
    if [ -z "$linux" ]; then
        pterohost_log "в архиве нет каталога Linux"
        rm -rf "$tmp"
        return 1
    fi

    cp -R "$linux"/* /home/container/
    chmod +x /home/container/TerrariaServer.bin.x86_64 2>/dev/null
    rm -rf "$tmp"
    rm -f /home/container/.terraria-* 2>/dev/null
    touch "/home/container/.terraria-${TERRARIA_VERSION}"
}

terraria_install_tshock() {
    [ -x /home/container/TShock.Server ] \
        && [ -f "/home/container/.tshock-${TSHOCK_VERSION}" ] && return 0

    local url
    url="$(terraria_github_asset Pryaxis/TShock 'linux-x64.*\.zip$' "$TSHOCK_VERSION")"
    if [ -z "$url" ]; then
        pterohost_log "сборка TShock ${TSHOCK_VERSION} не найдена"
        return 1
    fi

    pterohost_log "установка TShock: $url"
    local tmp="/home/container/.tshock-tmp"
    rm -rf "$tmp" && mkdir -p "$tmp"
    curl -fsSL "$url" -o "$tmp/tshock.zip" || { rm -rf "$tmp"; return 1; }
    unzip -oq "$tmp/tshock.zip" -d "$tmp" || true

    # Релизы приходят то zip-архивом, то zip с tar внутри.
    local tar
    tar="$(find "$tmp" -name '*.tar' | head -n 1)"
    [ -n "$tar" ] && tar -xf "$tar" -C "$tmp"

    local server
    server="$(find "$tmp" -name 'TShock.Server' -type f | head -n 1)"
    if [ -z "$server" ]; then
        pterohost_log "в архиве TShock нет TShock.Server"
        rm -rf "$tmp"
        return 1
    fi

    cp -R "$(dirname "$server")"/* /home/container/
    chmod +x /home/container/TShock.Server
    rm -rf "$tmp"
    rm -f /home/container/.tshock-* 2>/dev/null
    touch "/home/container/.tshock-${TSHOCK_VERSION}"
}

terraria_install_tmodloader() {
    [ -f /home/container/tModLoader.dll ] \
        && [ -f "/home/container/.tmodloader-${TMODLOADER_VERSION}" ] && return 0

    local url
    url="$(terraria_github_asset tModLoader/tModLoader 'tModLoader\.zip$' "$TMODLOADER_VERSION")"
    if [ -z "$url" ]; then
        pterohost_log "сборка tModLoader ${TMODLOADER_VERSION} не найдена"
        return 1
    fi

    pterohost_log "установка tModLoader: $url"
    local tmp="/home/container/.tmod-tmp"
    rm -rf "$tmp" && mkdir -p "$tmp"
    curl -fsSL "$url" -o "$tmp/tml.zip" || { rm -rf "$tmp"; return 1; }
    unzip -oq "$tmp/tml.zip" -d /home/container/ || true
    rm -rf "$tmp"
    chmod +x /home/container/*.sh /home/container/LaunchUtils/*.sh 2>/dev/null
    rm -f /home/container/.tmodloader-* 2>/dev/null
    touch "/home/container/.tmodloader-${TMODLOADER_VERSION}"
}

# Один конфиг на все ядра: TShock и tModLoader читают тот же serverconfig.txt.
# Файл создаётся один раз - дальше его правит владелец сервера, и перезаписывать
# его на каждом старте значит терять эти правки.
terraria_write_config() {
    local file="/home/container/serverconfig.txt"
    mkdir -p "$WORLD_DIR"
    [ -f "$file" ] && return 0

    pterohost_log "создаю serverconfig.txt"
    {
        echo "worldpath=${WORLD_DIR}"
        echo "worldname=${WORLD_NAME}"
        echo "world=${WORLD_DIR}/${WORLD_NAME}.wld"
        echo "autocreate=${WORLD_SIZE}"
        echo "difficulty=${WORLD_DIFFICULTY}"
        echo "maxplayers=${MAX_PLAYERS}"
        echo "port=${SERVER_PORT:-7777}"
        echo "secure=1"
        echo "language=en/US"
        [ -n "$SERVER_MOTD" ] && echo "motd=${SERVER_MOTD}"
        [ -n "$SERVER_PASSWORD" ] && echo "password=${SERVER_PASSWORD}"
    } > "$file"
}

case "$TERRARIA_CORE" in
    tshock)     terraria_install_tshock || exit 1 ;;
    tmodloader) terraria_install_tmodloader || exit 1 ;;
    *)          terraria_install_vanilla || exit 1 ;;
esac
terraria_write_config

pterohost_panel_argv "$@"
if [ "${PTEROHOST_FROM_PANEL}" != "1" ]; then
    case "$TERRARIA_CORE" in
        tshock)
            PTEROHOST_ARGS=(./TShock.Server -ip 0.0.0.0 -port "${SERVER_PORT:-7777}" \
                -config /home/container/serverconfig.txt)
            ;;
        tmodloader)
            # Минуя start-tModLoaderServer.sh: его ScriptCaller при каждом старте
            # зовёт InstallDotNet.sh и тянет свою копию .NET в каталог сервера,
            # хотя нужная восьмёрка стоит в образе. Запуск сборки напрямую
            # экономит около сотни мегабайт трафика и минуту первого старта.
            PTEROHOST_ARGS=(dotnet tModLoader.dll -server \
                -config /home/container/serverconfig.txt)
            ;;
        *)
            PTEROHOST_ARGS=(./TerrariaServer.bin.x86_64 -config /home/container/serverconfig.txt)
            ;;
    esac
fi

pterohost_append_if_absent -port -port "${SERVER_PORT:-}"
pterohost_append_if_absent -maxplayers -maxplayers "${MAX_PLAYERS:-}"
pterohost_append_if_absent -password -password "${SERVER_PASSWORD:-}"

pterohost_prune_empty_args "${PTEROHOST_ARGS[@]}"
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"
exec "${PTEROHOST_ARGS[@]}"
