#!/bin/bash
# Единый bootstrap для ботов и скриптов.
#
# Один egg на все рантаймы: сам рантайм выбирается docker-образом, а этот скрипт
# делает одинаковую для всех работу - подтягивает репозиторий, ставит зависимости
# по манифесту проекта и запускает точку входа. Клиент может перекрыть запуск
# целиком через START_COMMAND, не трогая egg.

set -u
cd /home/container || exit 1

. /usr/local/lib/pterohost/launch.sh

RUNTIME_KIND="${PTEROHOST_RUNTIME_KIND:-node}"
MAIN_FILE="${MAIN_FILE:-}"
START_COMMAND="${START_COMMAND:-}"
EXTRA_ARGS="${EXTRA_ARGS:-}"
AUTO_UPDATE="${AUTO_UPDATE:-0}"
AUTO_INSTALL="${AUTO_INSTALL:-1}"
INSTALL_PACKAGES="${INSTALL_PACKAGES:-}"
GIT_ADDRESS="${GIT_ADDRESS:-}"
BRANCH="${BRANCH:-}"
GIT_USERNAME="${GIT_USERNAME:-}"
GIT_TOKEN="${GIT_TOKEN:-}"

pterohost_log "рантайм: ${PTEROHOST_RUNTIME:-$RUNTIME_KIND}"

runtime_git_url() {
    local url="$1"
    [ -z "$url" ] && return 1
    [[ "$url" != *.git ]] && url="${url}.git"
    if [ -n "$GIT_USERNAME" ] && [ -n "$GIT_TOKEN" ]; then
        url="https://${GIT_USERNAME}:${GIT_TOKEN}@$(echo "$url" | cut -d/ -f3-)"
    fi
    printf '%s' "$url"
}

runtime_sync_repo() {
    [ -z "$GIT_ADDRESS" ] && return 0
    local url
    url="$(runtime_git_url "$GIT_ADDRESS")" || return 0

    if [ -d .git ]; then
        [ "$AUTO_UPDATE" = "1" ] || return 0
        pterohost_log "обновление репозитория"
        git -C /home/container pull --ff-only || pterohost_log "git pull не удался, работаем на том, что есть"
        return 0
    fi

    if [ -n "$(ls -A /home/container 2>/dev/null)" ]; then
        pterohost_log "каталог не пуст и это не репозиторий - клонирование пропущено"
        return 0
    fi

    pterohost_log "клонирование репозитория"
    if [ -n "$BRANCH" ]; then
        git clone --single-branch --branch "$BRANCH" "$url" /home/container
    else
        git clone "$url" /home/container
    fi
}

runtime_install() {
    [ "$AUTO_INSTALL" = "1" ] || return 0

    case "$RUNTIME_KIND" in
        node)
            [ -n "$INSTALL_PACKAGES" ] && npm install --no-fund --no-audit $INSTALL_PACKAGES
            if [ -f pnpm-lock.yaml ] && command -v pnpm >/dev/null 2>&1; then pnpm install
            elif [ -f yarn.lock ] && command -v yarn >/dev/null 2>&1; then yarn install
            elif [ -f package.json ]; then npm install --no-fund --no-audit
            fi
            ;;
        bun)
            [ -n "$INSTALL_PACKAGES" ] && bun add $INSTALL_PACKAGES
            [ -f package.json ] && bun install
            ;;
        python)
            [ -n "$INSTALL_PACKAGES" ] && pip install --no-cache-dir --user $INSTALL_PACKAGES
            [ -f requirements.txt ] && pip install --no-cache-dir --user -r requirements.txt
            [ -f pyproject.toml ] && [ ! -f requirements.txt ] && pip install --no-cache-dir --user .
            ;;
        go)
            [ -f go.mod ] && go mod download
            ;;
        rust)
            [ -f Cargo.toml ] && cargo build --release
            ;;
        dotnet)
            [ -n "$(ls -A ./*.csproj ./*.sln 2>/dev/null)" ] && dotnet restore
            ;;
        elixir)
            [ -f mix.exs ] && mix deps.get --force
            ;;
        dart)
            [ -f pubspec.yaml ] && dart pub get
            ;;
        java)
            :
            ;;
    esac

    return 0
}

# Кандидаты в точку входа: имя по умолчанию плюс то, как файл называют на самом
# деле. Клиент заливает свой проект целиком, и требовать от него именно index.js
# незачем - если подходящий файл ровно один, запускаем его и говорим об этом.
runtime_entry_candidates() {
    case "$RUNTIME_KIND" in
        node)   printf '%s\n' index.js main.js bot.js app.js server.js index.mjs index.cjs ;;
        bun)    printf '%s\n' index.ts index.js main.ts bot.ts app.ts ;;
        python) printf '%s\n' bot.py main.py run.py app.py __main__.py start.py ;;
        java)   printf '%s\n' bot.jar server.jar app.jar ;;
        dotnet) printf '%s\n' app.dll bot.dll ;;
        dart)   printf '%s\n' bin/main.dart bin/bot.dart ;;
        *)      ;;
    esac
}

# Проект собирается целиком (go, rust, elixir) - отдельного файла точки входа у
# него нет, и проверять его наличие нечего.
runtime_entry_is_file() {
    case "$RUNTIME_KIND" in
        node|bun|python|java|dotnet|dart) return 0 ;;
        *) return 1 ;;
    esac
}

runtime_present_candidates() {
    while IFS= read -r name; do
        [ -n "$name" ] && [ -f "$name" ] && printf '%s\n' "$name"
    done < <(runtime_entry_candidates)
}

# Угадывать можно только тогда, когда угадывать нечего: подходящий файл ровно
# один. Два кандидата - это выбор клиента, и молча взять первый значит запустить
# не тот файл и обвинить в этом клиента.
runtime_find_entry() {
    local list count
    list="$(runtime_present_candidates)"
    count="$(printf '%s' "$list" | grep -c . || true)"
    [ "$count" = "1" ] && printf '%s' "$list"
}

runtime_default_command() {
    local entry="$MAIN_FILE"

    case "$RUNTIME_KIND" in
        node)
            [ -z "$entry" ] && entry="index.js"
            if [[ "$entry" == *.ts ]] && command -v tsx >/dev/null 2>&1; then
                printf 'tsx %s' "$entry"
            else
                printf 'node %s' "$entry"
            fi
            ;;
        bun)
            [ -z "$entry" ] && entry="index.ts"
            printf 'bun run %s' "$entry"
            ;;
        python)
            [ -z "$entry" ] && entry="bot.py"
            printf 'python3 -u %s' "$entry"
            ;;
        java)
            [ -z "$entry" ] && entry="bot.jar"
            printf 'java -jar %s' "$entry"
            ;;
        go)
            [ -z "$entry" ] && entry="."
            printf 'go run %s' "$entry"
            ;;
        rust)
            printf 'cargo run --release'
            ;;
        dotnet)
            [ -z "$entry" ] && entry="app.dll"
            printf 'dotnet %s' "$entry"
            ;;
        elixir)
            printf 'mix run --no-halt'
            ;;
        dart)
            [ -z "$entry" ] && entry="bin/main.dart"
            printf 'dart run %s' "$entry"
            ;;
        *)
            printf ''
            ;;
    esac
}

runtime_sync_repo
# Сервер без проекта - это нормальное состояние только что купленной услуги:
# клиент ещё не залил файлы. Раньше такой сервер уходил в бесконечный
# перезапуск с трейсом рантайма («Cannot find module index.js»), из которого
# владелец не мог понять ни что случилось, ни что делать. Теперь он получает
# инструкцию в консоли и в файле, а сервер останавливается штатно.
runtime_explain_empty() {
    local entry="$1" others

    others="$(runtime_present_candidates | tr '\n' ' ')"
    if [ -n "${others// /}" ]; then
        pterohost_log "не понятно, что запускать: подходящих файлов несколько - ${others}"
        pterohost_log "укажите нужный в переменной MAIN_FILE - угадывать за вас мы не будем"
    else
        pterohost_log "запускать нечего: файла ${entry} в каталоге сервера нет"
        pterohost_log "1. загрузите файлы проекта через файловый менеджер панели или по SFTP"
    fi
    pterohost_log "2. рантайм выбирается образом в настройках сервера - Node.js, Python, Java, Go и другие"
    pterohost_log "3. имя файла запуска задаётся переменной MAIN_FILE, а произвольная команда - START_COMMAND"
    pterohost_log "4. зависимости ставятся сами по manifest проекта (package.json, requirements.txt и т.п.)"

    if [ -z "$(ls -A /home/container 2>/dev/null | grep -v '^\.pterohost$')" ]; then
        cat > "/home/container/КАК-ЗАПУСТИТЬ.txt" << 'INSTRUCTIONS'
Сервер готов, но проекта на нём ещё нет - его загружаете вы.

1. Загрузите файлы через файловый менеджер панели или по SFTP.
2. Выберите рантайм: в настройках сервера пункт «Образ» - Node.js, Bun, Python,
   Java, .NET, Go, Rust, Elixir или Dart.
3. Укажите файл запуска в переменной «Файл запуска» (MAIN_FILE), например
   main.py или index.js. Если запуск сложнее - впишите команду целиком в
   «Команда запуска» (START_COMMAND).
4. Зависимости ставятся сами: положите package.json, requirements.txt,
   go.mod, Cargo.toml или mix.exs. Отдельные пакеты можно перечислить в
   переменной «Пакеты для установки» (INSTALL_PACKAGES).
5. Можно не загружать файлы руками: укажите репозиторий в «Git-репозиторий»
   (GIT_ADDRESS) и переустановите сервер - проект склонируется сам.

Этот файл можно удалить.
INSTRUCTIONS
        pterohost_log "инструкция записана в КАК-ЗАПУСТИТЬ.txt"
    fi
}

runtime_install

pterohost_panel_argv "$@"
if [ "${PTEROHOST_FROM_PANEL}" != "1" ]; then
    command_line="$START_COMMAND"
    if [ -z "$command_line" ] && runtime_entry_is_file; then
        # Имя файла клиент мог не задать вовсе, а назвать его по-своему.
        if [ -z "$MAIN_FILE" ]; then
            detected="$(runtime_find_entry)"
            if [ -n "$detected" ]; then
                MAIN_FILE="$detected"
                pterohost_log "точка входа найдена: ${MAIN_FILE}"
            fi
        fi

        entry_file="${MAIN_FILE}"
        [ -z "$entry_file" ] && entry_file="$(runtime_default_command | awk '{print $NF}')"
        if [ ! -f "$entry_file" ]; then
            runtime_explain_empty "$entry_file"
            exit 0
        fi
    fi

    [ -z "$command_line" ] && command_line="$(runtime_default_command)"
    if [ -z "$command_line" ]; then
        pterohost_log "не задан ни START_COMMAND, ни точка входа - запускать нечего"
        exit 1
    fi
    [ -n "$EXTRA_ARGS" ] && command_line="$command_line $EXTRA_ARGS"
    pterohost_log "запуск: $command_line"
    exec /bin/bash -c "exec $command_line"
fi

pterohost_log_cmd "${PTEROHOST_ARGS[@]}"
exec "${PTEROHOST_ARGS[@]}"
