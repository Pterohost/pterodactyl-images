#!/bin/bash
# Pterohost Counter-Strike 2 bootstrap.
#
# CS2 is the one game here that cannot sit on the shared Debian base: Valve
# builds it against the Steam Runtime 3 ("sniper") container and its cs2.sh
# expects that environment. This image is therefore FROM the official sniper
# platform with SteamCMD installed on top, rather than FROM steamcmd_base.
#
# CS2 answers Valve A2S on the game port with no extra configuration, so the
# panel's status query needs nothing here - but -usercon is what makes RCON
# available, and a GSLT is what makes the server publicly listed.
#
# The name players see is a cvar in game/csgo/cfg/server.cfg, and until now the
# panel had no field for it: the only way to name a CS2 server here was to open
# the file manager and type it in. Eight of the nineteen live servers had done
# exactly that; the other eleven had no hostname line at all and were advertising
# Valve's default. SERVER_HOSTNAME now owns the cvar, and leaving it empty leaves
# the file alone - so the eight keep the name they typed.

set -u
cd /home/container || exit 1

# shellcheck source=/dev/null
. /usr/local/lib/pterohost/steam-update.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/cvarconf.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/launch.sh

log() { pterohost_log "$@"; }

APPID="${SRCDS_APPID:-730}"
BINARY="./game/cs2.sh"

if [ "${SRCDS_STOP_UPDATE:-0}" != "1" ]; then
    pterohost_steam_update "${APPID}" "${SRCDS_BETAID:-}" "${SRCDS_VALIDATE:-0}" \
        "/home/container/game/cs2.sh" || true
else
    log "SRCDS_STOP_UPDATE=1 - skipping SteamCMD."
    pterohost_steam_seed
    pterohost_steam_sdk
fi

# The name players see. server.cfg is the file that matters rather than the
# launch line, because the engine exec's it after every map load and a cvar set
# on the command line does not survive that.
CS2_CFG="/home/container/game/csgo/cfg/server.cfg"
if [ -n "${SERVER_HOSTNAME:-}" ] && [ ! -f "${CS2_CFG}" ] && [ -d "$(dirname "${CS2_CFG}")" ]; then
    : > "${CS2_CFG}"
fi
if [ -f "${CS2_CFG}" ]; then
    cvar_set_owned "${CS2_CFG}" hostname "${SERVER_HOSTNAME:-}"
    if [ -n "${SERVER_HOSTNAME:-}" ]; then
        log "Server name: ${SERVER_HOSTNAME}"
    else
        log "Server name left to server.cfg ($(cvar_get "${CS2_CFG}" hostname)); set it in the panel to manage it from there."
    fi
fi

# The base command, used only when the panel did not supply one (an egg that
# still reads "start-cs2" and nothing else).
args=(
    -dedicated
    +ip "${SERVER_IP}"
    -port "${SERVER_PORT}"
    +map "${SRCDS_MAP:-de_dust2}"
    -maxplayers "${SRCDS_MAXPLAYERS:-64}"
)

pterohost_panel_argv "$@"

if [ "${PTEROHOST_FROM_PANEL}" != "1" ]; then
    PTEROHOST_ARGS=("${BINARY}" "${args[@]}")
fi

# Without a Game Server Login Token the server never appears in the public
# browser. Passing an empty one is worse than passing none. Kept out of the
# egg because the panel renders the startup command with values substituted in.
[ -n "${STEAM_TOKEN:-}" ] && pterohost_append_if_absent +sv_setsteamaccount +sv_setsteamaccount "${STEAM_TOKEN}"

[ -n "${WORKSHOP_COLLECTION_ID:-}" ] && pterohost_append_if_absent +host_workshop_collection +host_workshop_collection "${WORKSHOP_COLLECTION_ID}"
[ -n "${WORKSHOP_MAP_ID:-}" ] && pterohost_append_if_absent +host_workshop_map +host_workshop_map "${WORKSHOP_MAP_ID}"

if [ -n "${RCON_PASS:-}" ]; then
    pterohost_append_if_absent +rcon_password +rcon_password "${RCON_PASS}" -usercon
fi

# A migrated egg carries {{ADDITIONAL_ARGS}} in the startup string itself.
if [ "${PTEROHOST_FROM_PANEL}" != "1" ] && [ -n "${ADDITIONAL_ARGS:-}" ]; then
    # shellcheck disable=SC2206
    PTEROHOST_ARGS+=(${ADDITIONAL_ARGS})
fi

log "Starting CS2 on ${SERVER_IP}:${SERVER_PORT} (${SRCDS_MAP:-de_dust2})."
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"

# cs2.sh reads console commands from stdin and the egg stops with "quit".
exec "${PTEROHOST_ARGS[@]}"
