#!/bin/bash
# Pterohost Garry's Mod bootstrap. 131 servers on this fleet - the largest
# single game, so this one stays deliberately close to the behaviour of the
# image it replaces and changes only what is worth changing.
#
# Notable:
#   -strictportbind. Without it srcds silently walks to the next free port when
#   the allocated one is briefly busy. The panel keeps advertising the
#   allocated port, so players cannot connect and the status query reads
#   whatever else happens to answer there. Failing loudly is better than
#   running somewhere nobody is looking; set SRCDS_STRICT_BIND=0 to opt out.
#
#   The variable is deliberately NOT called SRCDS_STRICT_PORT: the panel's
#   EggPortAnalyzer treats any egg variable matching /(^PORT_|_PORT$)/ as a port
#   it should allocate, so that name made the allocator hand it a real port
#   number (27001) instead of the 0/1 flag - silently disabling the feature and
#   burning an allocation per server. Never end a non-port variable in _PORT.

set -u
cd /home/container || exit 1

# shellcheck source=/dev/null
. /usr/local/lib/pterohost/steam-update.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/launch.sh

log() { pterohost_log "$@"; }

APPID="${SRCDS_APPID:-4020}"
BRANCH=""

# The 64-bit build lives on a Steam beta branch (x86-64). It is the default
# here: it is not constrained by the 32-bit address space, which is what a
# large addon/workshop load actually runs into, and it is measurably faster.
# Set USE_64BIT_BETA=0 for a server that needs a 32-bit-only binary module.
#
# Note this changes which depot SteamCMD pulls, so the first start after
# switching re-downloads the server files.
if [ "${USE_64BIT_BETA:-1}" = "1" ]; then
    BRANCH="x86-64"
    BINARY="./srcds_run_x64"
    SENTINEL="/home/container/srcds_run_x64"
else
    BINARY="./srcds_run"
    SENTINEL="/home/container/srcds_run"
fi

if [ "${AUTO_UPDATE:-1}" = "1" ]; then
    pterohost_steam_update "${APPID}" "${BRANCH}" "${VALIDATE:-0}" "${SENTINEL}" || true
else
    log "AUTO_UPDATE=0 - skipping SteamCMD."
    pterohost_steam_seed
    pterohost_steam_sdk
fi

# Fall back rather than fail: if the 64-bit depot did not land (a Steam hiccup,
# or the branch is unavailable), the 32-bit binary from the existing install
# still starts the server.
if [ ! -x "${BINARY}" ]; then
    log "WARN: ${BINARY} missing - falling back to ./srcds_run."
    BINARY="./srcds_run"
fi

# The base command, used only when the panel did not supply one (an egg that
# still reads "start-gmod" and nothing else). Migrated servers carry the same
# flags in their startup string, where the owner can see and edit them.
args=(
    -game garrysmod
    -console
    -port "${SERVER_PORT}"
    +ip "${SERVER_IP}"
    +map "${SRCDS_MAP:-gm_flatgrass}"
    +gamemode "${GAMEMODE:-sandbox}"
    +maxplayers "${MAX_PLAYERS:-32}"
    -tickrate "${TICKRATE:-22}"
    -norestart
    -nohltv
)

pterohost_panel_argv "$@"

if [ "${PTEROHOST_FROM_PANEL}" = "1" ]; then
    # The egg names ./srcds_run; the x86-64 branch installs a second binary.
    pterohost_swap_binary ./srcds_run "${BINARY}"
else
    PTEROHOST_ARGS=("${BINARY}" "${args[@]}")
fi

# From here on everything is appended only when the startup command does not
# already say otherwise - see the append-if-absent rule in launch.sh.

[ "${SRCDS_STRICT_BIND:-1}" = "1" ] && pterohost_append_if_absent -strictportbind -strictportbind
[ -n "${WORKSHOP_ID:-}" ] && pterohost_append_if_absent +host_workshop_collection +host_workshop_collection "${WORKSHOP_ID}"
[ "${LUA_REFRESH:-0}" = "1" ] || pterohost_append_if_absent -disableluarefresh -disableluarefresh

# Kept out of the visible startup string: a GSLT is a credential, and the panel
# renders the startup command with variable values substituted in.
[ -n "${STEAM_ACC:-}" ] && pterohost_append_if_absent +sv_setsteamaccount +sv_setsteamaccount "${STEAM_ACC}"

# RCON is how the panel enriches the player list with SteamIDs and IPs. Also a
# credential, so it stays here rather than in the egg.
if [ -n "${RCON_PASS:-}" ]; then
    pterohost_append_if_absent +rcon_password +rcon_password "${RCON_PASS}" -usercon
fi

[ -n "${NET_PUBLIC_IP:-}" ] && pterohost_append_if_absent +net_public_adr +net_public_adr "${NET_PUBLIC_IP}"
[ -n "${FPS_MAX:-}" ] && pterohost_append_if_absent +fps_max +fps_max "${FPS_MAX}"
[ -n "${SV_HIBERNATE:-}" ] && pterohost_append_if_absent +sv_hibernate_think +sv_hibernate_think "${SV_HIBERNATE}"
[ -n "${SV_PURE:-}" ] && pterohost_append_if_absent +sv_pure +sv_pure "${SV_PURE}"
[ -n "${SERVER_REGION:-}" ] && [ "${SERVER_REGION}" != "255" ] && pterohost_append_if_absent +sv_region +sv_region "${SERVER_REGION}"

if [ "${SERVER_LOG:-0}" = "1" ]; then
    pterohost_append_if_absent +sv_logfile +sv_logecho 1 +sv_logfile 1 +log on +sv_logflush 1
fi

# ---------------------------------------------------------------------------
# Performance.
#
# Be clear about what is actually on offer: Source runs its game loop on one
# thread by design. The x86-64 branch lifts the 2 GB address-space ceiling - the
# thing a big workshop/addon load genuinely hits - but it does not make the
# simulation parallel. Anything promising "multithreaded srcds" is either the
# job system below or a convar that has historically crashed GMod servers.
# ---------------------------------------------------------------------------

# The engine's job-system thread pool.
#
# This MUST come from the container's CPU quota, not from nproc. nproc reports
# the host's cores - 12, 24, 32 on these nodes - while the server is limited to
# a fraction of one or two. Letting srcds size its pool from nproc means dozens
# of job threads fighting over a 200% quota: pure context-switching, and the
# cgroup throttles the lot. That is the single most common way a "tuned" Source
# server ends up slower than an untuned one.
srcds_auto_threads() {
    local quota=""

    # cgroup v2, then v1.
    if [ -r /sys/fs/cgroup/cpu.max ]; then
        read -r q p < /sys/fs/cgroup/cpu.max 2>/dev/null
        if [ "${q}" != "max" ] && [ -n "${q}" ] && [ -n "${p}" ] && [ "${p}" -gt 0 ] 2>/dev/null; then
            quota=$(awk -v q="${q}" -v p="${p}" 'BEGIN{printf "%d", int(q/p)}')
        fi
    elif [ -r /sys/fs/cgroup/cpu/cpu.cfs_quota_us ] && [ -r /sys/fs/cgroup/cpu/cpu.cfs_period_us ]; then
        q=$(cat /sys/fs/cgroup/cpu/cpu.cfs_quota_us 2>/dev/null)
        p=$(cat /sys/fs/cgroup/cpu/cpu.cfs_period_us 2>/dev/null)
        if [ -n "${q}" ] && [ "${q}" -gt 0 ] 2>/dev/null && [ -n "${p}" ] && [ "${p}" -gt 0 ] 2>/dev/null; then
            quota=$(awk -v q="${q}" -v p="${p}" 'BEGIN{printf "%d", int(q/p)}')
        fi
    fi

    # No quota at all (unlimited plan): fall back to host cores, still capped.
    if [ -z "${quota}" ] || [ "${quota}" -lt 1 ] 2>/dev/null; then
        quota=$(nproc 2>/dev/null || echo 1)
    fi

    # Source gets nothing from a large pool; past a handful of threads it is all
    # overhead. One thread is left for the main game loop.
    local threads=$(( quota > 1 ? quota - 1 : 1 ))
    [ "${threads}" -gt 8 ] && threads=8

    echo "${threads}"
}

if pterohost_has_flag -threads "${PTEROHOST_ARGS[@]}"; then
    log "Job threads: taken from the startup command."
else
    case "${SRCDS_THREADS:-auto}" in
        ''|engine)
            : ;;                                   # leave the engine to decide
        auto)
            SRCDS_THREADS_RESOLVED="$(srcds_auto_threads)"
            PTEROHOST_ARGS+=(-threads "${SRCDS_THREADS_RESOLVED}")
            log "Job threads: ${SRCDS_THREADS_RESOLVED} (derived from the container CPU quota, not host cores)."
            ;;
        *)
            PTEROHOST_ARGS+=(-threads "${SRCDS_THREADS}")
            log "Job threads: ${SRCDS_THREADS} (set explicitly)."
            ;;
    esac
fi

# Both of these are experimental and upstream ships them off, because they have
# a long history of crashes and prediction errors on GMod specifically. They are
# ON by default here as a deliberate Pterohost choice - set the variable to 0 to
# roll back on a server that misbehaves; it takes effect on the next start.
if [ "${GMOD_MCORE:-1}" = "1" ] && ! pterohost_has_flag +gmod_mcore_test "${PTEROHOST_ARGS[@]}"; then
    log "gmod_mcore_test enabled (experimental; set GMOD_MCORE=0 if the server becomes unstable)."
    PTEROHOST_ARGS+=(+gmod_mcore_test 1)
fi

if [ "${SV_PARALLEL:-1}" = "1" ] && ! pterohost_has_flag +sv_parallel_packentities "${PTEROHOST_ARGS[@]}"; then
    log "Parallel entity packing/snapshots enabled (experimental; set SV_PARALLEL=0 to roll back)."
    PTEROHOST_ARGS+=(+sv_parallel_packentities 1 +sv_parallel_sendsnapshot 1)
fi

# glibc allocates an arena per thread, which inflates RSS in a memory-capped
# container without buying throughput for this workload.
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"

# jemalloc cuts fragmentation in a long-running, Lua-heavy, malloc-heavy
# process - the same reason the Rust image offers it. Only valid against the
# 64-bit binary: the library here is x86-64 and cannot preload into 32-bit
# srcds, so guard on which binary actually got selected.
if [ "${USE_JEMALLOC:-1}" = "1" ] && [ "${BINARY}" = "./srcds_run_x64" ] && [ -f "${JEMALLOC_LIB:-}" ]; then
    export LD_PRELOAD="${JEMALLOC_LIB}${LD_PRELOAD:+:${LD_PRELOAD}}"
    log "jemalloc preloaded."
fi

# A migrated egg carries {{ADDITIONAL_ARGS}} in the startup string itself;
# appending it again here would duplicate every flag the owner set.
if [ "${PTEROHOST_FROM_PANEL}" != "1" ] && [ -n "${ADDITIONAL_ARGS:-}" ]; then
    # shellcheck disable=SC2206
    PTEROHOST_ARGS+=(${ADDITIONAL_ARGS})
fi

log "Starting Garry's Mod on ${SERVER_IP}:${SERVER_PORT} (${SRCDS_MAP:-gm_flatgrass}, ${GAMEMODE:-sandbox}, tickrate ${TICKRATE:-22})."
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"

# exec: srcds reads console commands from stdin and the egg's stop command is
# "quit", so Wings' own stop path already works. No wrapper needed.
exec "${PTEROHOST_ARGS[@]}"
