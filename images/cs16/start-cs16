#!/bin/bash
# Counter-Strike 1.6 на ReHLDS.
#
# Ванильный hlds из депо 90 давно не обновляется и держит меньше игроков на том же
# железе, чем ReHLDS, поэтому движок подменяется сразу после установки игры. Всё,
# что нельзя выразить статической строкой запуска - подмена движка, установка
# Metamod и AMX Mod X, вычисленные порты - делается здесь, а сама команда живёт в
# egg (контракт запуска, shared/launch.sh).

set -u
cd /home/container || exit 1

. /usr/local/lib/pterohost/steam-update.sh
. /usr/local/lib/pterohost/launch.sh

APPID="${SRCDS_APPID:-90}"
HLDS_GAME="${HLDS_GAME:-cstrike}"
REHLDS_VERSION="${REHLDS_VERSION:-latest}"
USE_REHLDS="${USE_REHLDS:-1}"
INSTALL_METAMOD="${INSTALL_METAMOD:-0}"
INSTALL_AMXX="${INSTALL_AMXX:-0}"

pterohost_steam_update "${APPID}" "${SRCDS_BETAID:-}" "${VALIDATE:-0}" "/home/container/hlds_linux" || true

cs16_github_asset() {
    local repo="$1" pattern="$2" tag="${3:-latest}"
    local api="https://api.github.com/repos/${repo}/releases/${tag}"
    [ "$tag" != "latest" ] && api="https://api.github.com/repos/${repo}/releases/tags/${tag}"

    curl -fsSL "$api" 2>/dev/null \
        | grep -o '"browser_download_url": *"[^"]*"' \
        | cut -d'"' -f4 \
        | grep -i "$pattern" \
        | head -n 1
}

# NUL-delimited, so a match is exact. A plain grep for SteamGameServer_Init also
# hits SteamGameServer_InitSafe, which is a different function - and that is
# precisely the distinction this check exists to make.
cs16_elf_strings() { tr '\0' '\n' < "$1" 2>/dev/null; }

# ReHLDS links against SteamGameServer_Init. Valve's current app-90 depot ships
# a libsteam_api.so that exports SteamGameServer_InitSafe and
# SteamInternal_GameServer_Init but NOT that symbol, and every published ReHLDS
# build from 3.11.0.767 to 3.15.0.896 needs it (checked 2026-09-02). hlds_linux
# then dies inside dlopen with
#     Error: engine_i486.so: undefined symbol: SteamGameServer_Init
#     Unable to load engine, image is corrupt.
# before the console prints anything at all. So the swap is verified before it
# is kept: an engine the shipped Steam library cannot satisfy is not installed,
# and the customer gets a working stock server plus a line saying why, instead
# of a server that cannot boot.
cs16_engine_is_loadable() { # <candidate engine .so>
    local api="/home/container/libsteam_api.so" sym
    [ -f "$api" ] || return 0
    for sym in $(cs16_elf_strings "$1" | grep -x 'SteamGameServer_Init'); do
        cs16_elf_strings "$api" | grep -qx "$sym" || return 1
    done
    return 0
}

cs16_engine_sig() { sha256sum /home/container/engine_i486.so 2>/dev/null | cut -d' ' -f1; }

cs16_install_rehlds() {
    [ "$USE_REHLDS" = "1" ] || return 0

    # The marker used to be a bare .rehlds-<version> touch file, which made the
    # engine swap a once-ever action. pterohost_steam_update runs BEFORE this
    # and, with VALIDATE=1, SteamCMD restores engine_i486.so from the depot - so
    # the engine quietly reverted to stock on the second start and the marker
    # then stopped it ever being re-applied. Key the state to the engine that is
    # actually on disk instead: a restored depot file changes the digest and the
    # swap runs again, while a settled engine (ReHLDS installed, or ReHLDS
    # rejected as unloadable) short-circuits without touching the network.
    local state="/home/container/.rehlds-state"
    [ -f "$state" ] && [ "$(cat "$state" 2>/dev/null)" = "$(cs16_engine_sig)" ] && return 0

    local url
    url="$(cs16_github_asset dreamstalker/rehlds 'rehlds-bin.*\.zip$' "$REHLDS_VERSION")"
    if [ -z "$url" ]; then
        pterohost_log "не нашёл сборку ReHLDS ${REHLDS_VERSION}, остаюсь на ванильном движке"
        return 0
    fi

    pterohost_log "установка ReHLDS: $url"
    local tmp="/home/container/.rehlds-tmp"
    rm -rf "$tmp" && mkdir -p "$tmp"
    if ! curl -fsSL "$url" -o "$tmp/rehlds.zip"; then
        pterohost_log "ReHLDS не скачался, остаюсь на ванильном движке"
        rm -rf "$tmp"
        return 0
    fi

    unzip -oq "$tmp/rehlds.zip" -d "$tmp" || true
    # Раскладка архива менялась между релизами, поэтому ищем файлы, а не путь.
    local engine
    engine="$(find "$tmp" -name 'engine_i486.so' | head -n 1)"
    if [ -z "$engine" ]; then
        pterohost_log "в архиве ReHLDS нет engine_i486.so, остаюсь на ванильном движке"
        rm -rf "$tmp"
        return 0
    fi

    if ! cs16_engine_is_loadable "$engine"; then
        pterohost_log "ReHLDS ${REHLDS_VERSION} не сходится с этой сборкой HLDS: движку нужен SteamGameServer_Init, которого нет в libsteam_api.so из депо 90. Остаюсь на ванильном движке - сервер запустится, но без ускорений ReHLDS."
        rm -rf "$tmp"
        cs16_engine_sig > "$state"
        return 0
    fi

    cp -f "$engine" /home/container/engine_i486.so
    pterohost_log "движок подменён на ReHLDS"
    rm -f /home/container/.rehlds-* 2>/dev/null
    cs16_engine_sig > "$state"
    rm -rf "$tmp"
}

# liblist.gam is the only place the engine looks to find the game library, and
# it is the one file in this bootstrap that can make a server permanently
# unstartable. So it is written from exactly one function, and only after the
# target has been seen on disk. A dead path there is not a degraded server, it
# is
#     Host_Error: Couldn't get DLL API from !
# and a container that exits 255 on every start, for ever, because the bad line
# outlives the restart that was supposed to clear it. That is what the first
# CS 1.6 customer got (server 4429, 2026-09-02): the Metamod archive carries an
# addons/metamod/ prefix and names its module metamod_i386.so, both of which
# this script used to guess wrong, and liblist.gam was rewritten anyway.
# Which Metamod, and why this one rather than the obvious one.
#
# Metamod-R exports its engine entry points with an ELF symbol version -
# GiveFnptrsToDll@@METAMOD_ABI_1.0 - which only ReHLDS's loader resolves. On the
# stock GoldSrc engine hlds prints
#     Couldn't get GiveFnptrsToDll in
#     Host_Error: Couldn't get DLL API from !
# and exits 255, and the blank filename in that message sends you looking for a
# missing file rather than an unresolvable symbol. Since ReHLDS itself cannot
# currently be installed at all (see cs16_install_rehlds), Metamod-R means a
# server that never starts.
#
# Metamod-P exports them unversioned and needs nothing newer than GLIBC 2.4, so
# it loads on the stock engine and on ReHLDS alike. Measured on server 4429,
# 2026-09-02: Metamod 1.21p109 + AMX Mod X 1.10.0.5479 loaded, Steam connected,
# VAC secure mode active.
CS16_METAMOD_SO=""

cs16_set_gamedll() { # <path relative to the game dir>
    local liblist="/home/container/${HLDS_GAME}/liblist.gam"
    [ -f "$liblist" ] || return 0
    grep -q "^gamedll_linux \"$1\"" "$liblist" && return 0
    sed -i "s|^gamedll_linux.*|gamedll_linux \"$1\"|" "$liblist"
    pterohost_log "liblist.gam: gamedll_linux -> $1"
}

# Metamod-P puts the module in addons/metamod/dlls/, Metamod-R directly in
# addons/metamod/ and calls it metamod_i386.so. Accept whichever is there - a
# volume that already has one must not be re-installed over - and let the caller
# write whatever path was found into liblist.gam.
cs16_metamod_so() {
    local dir="/home/container/${HLDS_GAME}/addons/metamod"
    find "$dir" -maxdepth 2 -type f \
        \( -name 'metamod.so' -o -name 'metamod_i386.so' \) 2>/dev/null | head -n 1
}

cs16_install_metamod() {
    local game="/home/container/${HLDS_GAME}"

    if [ "$INSTALL_METAMOD" != "1" ]; then
        # Also the un-poisoning path: a server that had Metamod and then turned
        # it off must stop naming a plugin loader it no longer loads.
        cs16_set_gamedll "dlls/cs.so"
        return 0
    fi

    local so
    so="$(cs16_metamod_so)"
    if [ -z "$so" ]; then
        pterohost_log "установка Metamod"
        local url tmp="/home/container/.metamod-tmp"
        # The ubuntu1804 asset is the portable one - its newest glibc reference
        # is GLIBC_2.4 - and this image is Debian 12. The ubuntu2404 asset wants
        # a glibc newer than the base has.
        url="$(cs16_github_asset Bots-United/metamod-p 'linux_ubuntu1804.*\.tar\.xz$')"
        [ -z "$url" ] && url="$(cs16_github_asset Bots-United/metamod-p 'linux.*\.tar\.xz$')"
        if [ -z "$url" ]; then
            pterohost_log "сборка Metamod не найдена"
        else
            rm -rf "$tmp" && mkdir -p "$tmp"
            # xz -dc | tar -x rather than tar -J: the base image ships xz as a
            # separate binary and tar's own -J is not wired to it.
            if curl -fsSL "$url" -o "$tmp/metamod.tar.xz" \
                && xz -dc "$tmp/metamod.tar.xz" | tar -x -C "$tmp"; then
                # Найти файл, а не довериться пути - раскладка архивов Metamod
                # менялась между сборками, ровно как у ReHLDS выше.
                local src
                src="$(find "$tmp" -type f -name 'metamod.so' | head -n 1)"
                if [ -n "$src" ]; then
                    mkdir -p "${game}/addons/metamod/dlls"
                    cp -f "$src" "${game}/addons/metamod/dlls/metamod.so"
                else
                    pterohost_log "в архиве Metamod нет metamod.so"
                fi
            else
                pterohost_log "Metamod не скачался"
            fi
            rm -rf "$tmp"
        fi
        so="$(cs16_metamod_so)"
    fi

    if [ -z "$so" ]; then
        pterohost_log "Metamod не установлен - запускаюсь на штатной библиотеке игры, плагины работать не будут"
        cs16_set_gamedll "dlls/cs.so"
        return 1
    fi

    CS16_METAMOD_SO="$so"
    cs16_set_gamedll "${so#${game}/}"
}

cs16_amxx_register() {
    local plugins="/home/container/${HLDS_GAME}/addons/metamod/plugins.ini"
    mkdir -p "$(dirname "$plugins")"
    grep -qs 'amxmodx_mm_i386.so' "$plugins" 2>/dev/null \
        || echo 'linux addons/amxmodx/dlls/amxmodx_mm_i386.so' >> "$plugins"
}

cs16_install_amxx() {
    [ "$INSTALL_AMXX" = "1" ] || return 0
    local game="/home/container/${HLDS_GAME}"

    # AMX Mod X - это плагин Metamod. Без Metamod его некому загрузить, а
    # запись в plugins.ini только создала бы вид, что мод установлен.
    if [ -z "$CS16_METAMOD_SO" ]; then
        pterohost_log "AMX Mod X пропущен: его грузит Metamod, а Metamod не установлен"
        return 0
    fi

    if [ -f "${game}/addons/amxmodx/dlls/amxmodx_mm_i386.so" ]; then
        cs16_amxx_register
        return 0
    fi

    pterohost_log "установка AMX Mod X"
    # www.amxmodx.org/release/<конкретная версия> отдаёт 404: каталог релизов не
    # является стабильным URL. latest.php - тот же редиректор, которым
    # пользуется страница загрузки самого проекта. base - ядро AMXX, cstrike -
    # модули csx/cstrike/fun, без которых не работает почти ни один плагин
    # под CS 1.6.
    local pkg tarball
    for pkg in base cstrike; do
        tarball="/tmp/amxx-${pkg}.tar.gz"
        if ! { curl -fsSL "https://www.amxmodx.org/latest.php?version=1.10&os=linux&package=${pkg}" -o "$tarball" \
                && tar -xzf "$tarball" -C "${game}"; }; then
            pterohost_log "AMX Mod X: пакет ${pkg} не установился"
        fi
        rm -f "$tarball"
    done

    if [ ! -f "${game}/addons/amxmodx/dlls/amxmodx_mm_i386.so" ]; then
        pterohost_log "AMX Mod X не установлен"
        return 0
    fi
    cs16_amxx_register
}

cs16_install_rehlds
cs16_install_metamod
cs16_install_amxx

pterohost_panel_argv "$@"
if [ "${PTEROHOST_FROM_PANEL}" != "1" ]; then
    PTEROHOST_ARGS=(./hlds_run -console -game "${HLDS_GAME}" -port "${SERVER_PORT}" \
        -sport "${VAC_PORT:-26900}" +map "${SRCDS_MAP:-de_dust2}" +ip 0.0.0.0 -strictportbind -norestart)
fi

pterohost_append_if_absent +maxplayers +maxplayers "${MAX_PLAYERS:-}"
pterohost_append_if_absent +rcon_password +rcon_password "${RCON_PASSWORD:-}"

pterohost_prune_empty_args "${PTEROHOST_ARGS[@]}"
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"
exec "${PTEROHOST_ARGS[@]}"
