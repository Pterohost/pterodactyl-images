#!/bin/bash
# Pterohost Rust bootstrap.
#
# Invoked via the shared entrypoint (Wings STARTUP="start-rust" -> eval exec
# start-rust). Updates RustDedicated via anonymous SteamCMD, installs/updates the
# selected modding framework deterministically, then launches the server.
#
# This script OWNS all the logic the old third-party image hid. Every network
# step is non-fatal (log + continue, never exit 1) so a transient CDN hiccup can
# never leave a customer's server refusing to boot - the exact failure mode of
# the old Chaos-extension 406 that killed the container.
#
# Env (from the Pterodactyl egg / Wings), with sane fallbacks:
#   MODDING_FRAMEWORK  vanilla | oxide | carbon        (default: oxide)
#   STEAM_BRANCH       public | staging | aux01 | aux02 (default: public)
#   FRAMEWORK_UPDATE   1 = re-pull framework each boot, 0 = only if missing
#   AUTO_UPDATE        1 = SteamCMD app_update each boot, 0 = skip
#   VALIDATE           1 = SteamCMD validate, 0 = skip
#   USE_JEMALLOC       1 = LD_PRELOAD jemalloc (default 0; ignored for Oxide - it
#                      crashes Oxide's compiler; safe only for vanilla/Carbon)
#   CHAOS_DL / DISCORD_EXT / RUSTEDIT_EXT  1 = fetch that Oxide extension
#   TICKRATE, FPS_LIMIT, GC_BUFFER         performance knobs
#   RCON_REPLY_WINDOW  seconds to wait for a console command's RCON reply (5)
#   SERVER_PORT (Wings), QUERY_PORT, RCON_PORT, RCON_PASS, APP_PORT,
#   SERVER_IDENTITY, HOSTNAME, DESCRIPTION, SERVER_URL, SERVER_IMG, SERVER_LOGO,
#   MAX_PLAYERS, SAVEINTERVAL, GAMEMODE, WORLD_SIZE, WORLD_SEED, LEVEL, MAP_URL,
#   SERVER_TAGS, APP_PUBLIC_IP, ADDITIONAL_ARGS
set -u

APPID=258550
STEAMCMD_SRC="${STEAMCMD_DIR:-/opt/steamcmd}"
# Wings mounts the container root read-only; SteamCMD self-updates into its own
# directory, so run it from a writable copy inside the (persistent) server volume.
STEAMCMD_RUN="/home/container/.steamcmd"
JEMALLOC_LIB="${JEMALLOC_LIB:-/usr/lib/x86_64-linux-gnu/libjemalloc.so.2}"

FRAMEWORK="$(echo "${MODDING_FRAMEWORK:-oxide}" | tr '[:upper:]' '[:lower:]')"
BRANCH="$(echo "${STEAM_BRANCH:-public}" | tr '[:upper:]' '[:lower:]')"

log() { printf '[rust] %s\n' "$*"; }

# shellcheck source=/dev/null
. /usr/local/lib/pterohost/identity.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/launch.sh

BINARY="./RustDedicated"

cd /home/container || { log "FATAL: cannot cd /home/container"; exit 1; }

# +server.identity names server/<identity>, which is the whole server: the map,
# the saves, the player blueprints, the clan database, the loadouts and cfg. It
# is an editable panel field, so changing it did not rename anything - it pointed
# Rust at an identity that did not exist and it generated a fresh world, leaving
# the real one on disk where the panel could not reach it. The data now follows
# the field; see shared/identity.sh for the rules.
pterohost_ident_sync "/home/container/.pterohost-server-identity" "${SERVER_IDENTITY:-rust}" 'server/@'

# Wings gives the container a small (~100 MB) /tmp tmpfs; SteamCMD stages far more
# than that and fails with "Missing configuration" when /tmp fills. Point TMPDIR
# at the large server volume instead.
export TMPDIR="/home/container/.tmp"
mkdir -p "${TMPDIR}"

# Detect a framework switch. Oxide PATCHES the game's Assembly-CSharp.dll (adds an
# IPlayer field bound to Oxide.Core), so switching to Carbon/vanilla with those
# assemblies in place crashes with "Could not load Oxide.Core". A plain validate
# will not help (SteamCMD reports "up to date"), so we DELETE the Oxide-patched
# assemblies and let a forced validate re-download the vanilla ones.
LAST_FW_FILE="/home/container/.pterohost_framework"
LAST_FW="$(cat "${LAST_FW_FILE}" 2>/dev/null || echo '')"
MANAGED_DIR="/home/container/RustDedicated_Data/Managed"
FORCE_VALIDATE=0
if [ "${FRAMEWORK}" != "oxide" ] && { [ "${LAST_FW}" = "oxide" ] || ls "${MANAGED_DIR}"/Oxide.*.dll >/dev/null 2>&1; }; then
    log "Switching away from Oxide -> removing Oxide-patched assemblies; SteamCMD will restore vanilla ones."
    rm -f "${MANAGED_DIR}"/Assembly-CSharp.dll "${MANAGED_DIR}"/Oxide.*.dll "${MANAGED_DIR}"/Oxide.References.dll.config 2>/dev/null || true
    FORCE_VALIDATE=1
fi

# rust_steam_update <steamcmd.sh> <validate 0|1> [branch args...]
#   Runs app_update and decides from what SteamCMD itself reported whether it
#   worked. The old check was "RustDedicated exists", which is true on every boot
#   after the first, so a failed update printed "SteamCMD update OK." and the
#   server came up on the previous build: ticket 4038 (node03, Carbon) sat on
#   buildid 25902425 / protocol 2634 after Facepunch shipped 26139947 / 2635, and
#   tickets 4683/4785 (node12) on 25823813 - nobody could join with a current
#   client. SteamCMD's console says "Error! App ... state is 0x... after update
#   job" or "ERROR! Failed to install app", and Steam/logs/content_log.txt says
#   why ("Failed updating depot 258552 ... (Read Failed) (Corrupt game files)
#   .../Managed/System.Data.dll", "(Missing game files)"). Success needs the
#   "Success! App ..." line, no error line, and an app manifest that reads
#   StateFlags 4 (fully installed, nothing pending).
#
#   Corrupt or missing files are not transient: the delta patch is computed
#   against a file that no longer matches (Oxide's patcher, a plugin, a disk
#   hiccup) and every plain retry fails the same way. That case gets one retry
#   with `validate` after the half-applied staging in steamapps/downloading is
#   cleared - the same two steps that fixed 4038 and 4683 by hand. validate
#   restores Steam's own assemblies, so RUST_VALIDATED=1 tells the framework
#   step below to re-apply Oxide/Carbon even with FRAMEWORK_UPDATE=0.
rust_manifest_field() { # <key>
    sed -n -E "s/^[[:space:]]*\"$1\"[[:space:]]+\"([^\"]*)\".*/\\1/p" \
        "/home/container/steamapps/appmanifest_${APPID}.acf" 2>/dev/null | head -n 1
}

rust_steam_failure() { # <console log> <content log segment> -> reason on stdout, 0 if failed
    local out="$1" content="$2" error flags cause
    error="$(grep -m 1 -E "ERROR! |Error! App '${APPID}' state is" "${out}" 2>/dev/null)"
    flags="$(rust_manifest_field StateFlags)"
    if [ -z "${error}" ] && grep -qE "Success! App '${APPID}' (fully installed|already up to date)" "${out}" 2>/dev/null \
        && { [ -z "${flags}" ] || [ "${flags}" = "4" ]; }; then
        return 1
    fi
    cause="$(grep -m 1 -iE "Failed updating depot|update canceled" "${content}" 2>/dev/null)"
    if [ -n "${cause}" ]; then
        printf '%s\n' "${cause#*] }"
    elif [ -n "${error}" ]; then
        printf '%s\n' "${error}"
    elif [ -n "${flags}" ] && [ "${flags}" != "4" ]; then
        printf 'app manifest StateFlags %s after the update (4 = fully installed)\n' "${flags}"
    else
        printf 'SteamCMD did not report success\n'
    fi
    return 0
}

rust_steam_update() { # <steamcmd.sh> <validate 0|1> [branch args...]
    local steamcmd="$1" validate="$2"; shift 2
    local branch_args=("$@") validate_arg=() attempt=1 max_attempts="${STEAMCMD_ATTEMPTS:-3}"
    local out content content_log="/home/container/Steam/logs/content_log.txt"
    local before after offset rc reason="" retried=0
    [ "${validate}" -gt 0 ] && validate_arg=(validate)
    out="$(mktemp "${TMPDIR:-/tmp}/steamcmd.XXXXXX")"
    content="$(mktemp "${TMPDIR:-/tmp}/content.XXXXXX")"
    before="$(rust_manifest_field buildid)"

    while [ "${attempt}" -le "${max_attempts}" ]; do
        log "SteamCMD attempt ${attempt}/${max_attempts}${validate_arg[*]:+ (validate)}..."
        offset="$(stat -c %s "${content_log}" 2>/dev/null || echo 0)"
        timeout "${STEAMCMD_TIMEOUT:-1800}" "${steamcmd}" \
            +@ShutdownOnFailedCommand 1 +@NoPromptForPassword 1 \
            +force_install_dir /home/container \
            +login anonymous \
            +app_update "${APPID}" "${branch_args[@]}" "${validate_arg[@]}" \
            +quit 2>&1 | tee "${out}"
        rc="${PIPESTATUS[0]}"
        if [ "$(stat -c %s "${content_log}" 2>/dev/null || echo 0)" -lt "${offset}" ]; then offset=0; fi
        tail -c "+$((offset + 1))" "${content_log}" > "${content}" 2>/dev/null || : > "${content}"

        if ! reason="$(rust_steam_failure "${out}" "${content}")"; then
            after="$(rust_manifest_field buildid)"
            if [ -n "${before}" ] && [ "${before}" = "${after}" ]; then
                log "SteamCMD update OK - already on the latest build ${after}."
            else
                log "SteamCMD update OK - build ${before:-none} -> ${after:-unknown}."
            fi
            rm -f "${out}" "${content}"
            return 0
        fi
        [ "${rc}" = "124" ] && reason="timed out after ${STEAMCMD_TIMEOUT:-1800}s; ${reason}"
        log "SteamCMD attempt ${attempt} FAILED (exit ${rc}): ${reason}"

        if [ "${retried}" = "0" ] && grep -qiE "Corrupt game files|Read Failed|Missing game files" "${out}" "${content}" 2>/dev/null; then
            retried=1
            validate_arg=(validate)
            RUST_VALIDATED=1
            if [ -d "/home/container/steamapps/downloading/${APPID}" ]; then
                log "Clearing the half-applied update in steamapps/downloading/${APPID}."
                rm -rf "/home/container/steamapps/downloading/${APPID:?}"
            fi
            log "Game files do not match what the update expects - retrying once with validate."
            continue
        fi
        attempt=$((attempt + 1))
        [ "${attempt}" -le "${max_attempts}" ] && sleep "${STEAMCMD_RETRY_SLEEP:-5}"
    done

    rm -f "${out}" "${content}"
    if [ -x /home/container/RustDedicated ]; then
        log "WARN: SteamCMD update FAILED (${reason}) - starting the build already on disk (buildid $(rust_manifest_field buildid))."
        log "WARN: if Facepunch released a newer build, current game clients cannot join until an update succeeds."
    else
        log "WARN: RustDedicated missing after ${max_attempts} attempts (${reason}) - continuing with existing files."
    fi
    return 1
}

# ---------------------------------------------------------------------------
# 1. Update / validate RustDedicated via anonymous SteamCMD.
# ---------------------------------------------------------------------------
if [ "${AUTO_UPDATE:-1}" = "1" ] || [ "${FORCE_VALIDATE}" = "1" ]; then
    # Seed the writable SteamCMD copy on first boot (idempotent).
    if [ ! -x "${STEAMCMD_RUN}/steamcmd.sh" ]; then
        mkdir -p "${STEAMCMD_RUN}"
        cp -a "${STEAMCMD_SRC}/." "${STEAMCMD_RUN}/" 2>/dev/null || true
    fi
    mkdir -p /home/container/steamapps  # avoids a spurious steamcmd disk-write error

    branch_args=()
    case "${BRANCH}" in
        public|"") ;;                              # default branch: no -beta
        *) branch_args=(-beta "${BRANCH}") ;;
    esac
    validate_arg=()
    { [ "${VALIDATE:-1}" = "1" ] || [ "${FORCE_VALIDATE}" = "1" ]; } && validate_arg=(validate)

    log "Updating RustDedicated (app ${APPID}${BRANCH:+, branch ${BRANCH}})..."
    # First run self-updates SteamCMD (and restarts it); do it in a throwaway pass
    # so the real update starts from a settled SteamCMD.
    "${STEAMCMD_RUN}/steamcmd.sh" +@ShutdownOnFailedCommand 1 +@NoPromptForPassword 1 +quit >/dev/null 2>&1 || true

    rust_steam_update "${STEAMCMD_RUN}/steamcmd.sh" "${#validate_arg[@]}" "${branch_args[@]}" || true
else
    log "AUTO_UPDATE=0 - skipping SteamCMD, using existing server files."
fi

# ---------------------------------------------------------------------------
# 2. Steam client SDK - required before Steamworks (server browser) initialises.
# ---------------------------------------------------------------------------
mkdir -p "${HOME}/.steam/sdk32" "${HOME}/.steam/sdk64"
[ -f "${STEAMCMD_RUN}/linux32/steamclient.so" ] && ln -sf "${STEAMCMD_RUN}/linux32/steamclient.so" "${HOME}/.steam/sdk32/steamclient.so"
[ -f "${STEAMCMD_RUN}/linux64/steamclient.so" ] && ln -sf "${STEAMCMD_RUN}/linux64/steamclient.so" "${HOME}/.steam/sdk64/steamclient.so"

# ---------------------------------------------------------------------------
# 3. Modding framework install / update.
#    Applied AFTER the Steam update, because `validate` restores the original
#    game assemblies and would otherwise undo an Oxide patch.
# ---------------------------------------------------------------------------
fw_should_update() { [ "${FRAMEWORK_UPDATE:-1}" = "1" ] || [ "${RUST_VALIDATED:-0}" = "1" ]; }

install_oxide() {
    if [ -d /home/container/oxide ] && ! fw_should_update; then
        log "Oxide present and FRAMEWORK_UPDATE=0 - keeping existing install."; return 0
    fi
    local url="https://github.com/OxideMod/Oxide.Rust/releases/latest/download/Oxide.Rust-linux.zip"
    log "Installing/updating Oxide (uMod) from ${url}"
    if curl -fsSL --retry 3 --max-time 300 -o "${TMPDIR}/oxide.zip" "${url}"; then
        unzip -oq "${TMPDIR}/oxide.zip" -d /home/container && log "Oxide applied." \
            || log "WARN: Oxide unzip failed - continuing (server will run vanilla)."
        rm -f "${TMPDIR}/oxide.zip"
    else
        log "WARN: Oxide download failed - continuing with existing files."
    fi
    mkdir -p /home/container/oxide/plugins
}

install_carbon() {
    if [ -d /home/container/carbon ] && ! fw_should_update; then
        log "Carbon present and FRAMEWORK_UPDATE=0 - keeping existing install."; return 0
    fi
    # Carbon publishes rolling release tags; map the Steam branch onto its channel.
    local tag="production_build"
    case "${BRANCH}" in *staging*) tag="rustbeta_staging_build" ;; esac
    local url="https://github.com/CarbonCommunity/Carbon.Core/releases/download/${tag}/Carbon.Linux.Release.tar.gz"
    log "Installing/updating Carbon (${tag}) from ${url}"
    if curl -fsSL --retry 3 --max-time 300 -o "${TMPDIR}/carbon.tar.gz" "${url}"; then
        tar -xzf "${TMPDIR}/carbon.tar.gz" -C /home/container && log "Carbon extracted." \
            || log "WARN: Carbon extract failed - continuing (server will run vanilla)."
        rm -f "${TMPDIR}/carbon.tar.gz"
    else
        log "WARN: Carbon download failed - continuing with existing files."
    fi
    mkdir -p /home/container/carbon/plugins /home/container/carbon/extensions
}

# Where Oxide-style extension DLLs go for the active framework.
managed_dir() {
    if [ "${FRAMEWORK}" = "carbon" ]; then echo "/home/container/carbon/extensions";
    else echo "/home/container/RustDedicated_Data/Managed"; fi
}

fetch_ext() { # <flag_value> <name> <url>
    [ "${1:-0}" = "1" ] || return 0
    local name="$2" url="$3" dir; dir="$(managed_dir)"
    mkdir -p "${dir}"
    log "Fetching extension ${name}..."
    curl -fsSL --retry 2 --max-time 180 -o "${dir}/${name}" "${url}" \
        && log "  ${name} OK" \
        || log "  WARN: ${name} download failed (${url}) - continuing without it."
}

CARBON_PRELOAD=""
case "${FRAMEWORK}" in
    oxide)
        install_oxide
        ;;
    carbon)
        install_carbon
        # Carbon boots via a Unity doorstop preload. Its release ships the
        # authoritative env file (carbon/tools/environment.sh) which exports
        # DOORSTOP_* + LD_LIBRARY_PATH and sets LD_PRELOAD to the root-level
        # libdoorstop.so. Source it; fall back to the known layout if absent.
        if [ -f /home/container/carbon/tools/environment.sh ]; then
            # shellcheck disable=SC1091
            source /home/container/carbon/tools/environment.sh || true
        else
            export DOORSTOP_ENABLED=1
            export DOORSTOP_TARGET_ASSEMBLY="/home/container/carbon/managed/Carbon.Preloader.dll"
            export LD_LIBRARY_PATH="/home/container:/home/container/RustDedicated_Data/Plugins/x86_64:${LD_LIBRARY_PATH:-}"
            [ -f /home/container/libdoorstop.so ] && export LD_PRELOAD="/home/container/libdoorstop.so"
        fi
        # Capture the doorstop preloader and clear LD_PRELOAD so the performance
        # section below rebuilds it as "jemalloc:libdoorstop" without duplication.
        CARBON_PRELOAD="${LD_PRELOAD:-}"
        unset LD_PRELOAD
        ;;
    vanilla)
        log "Framework: vanilla (no mod loader)."
        ;;
    *)
        log "WARN: unknown MODDING_FRAMEWORK='${FRAMEWORK}', defaulting to oxide."
        FRAMEWORK="oxide"; install_oxide
        ;;
esac

# Optional Oxide extensions (guarded; only meaningful for oxide/carbon).
if [ "${FRAMEWORK}" != "vanilla" ]; then
    fetch_ext "${CHAOS_DL:-0}"     "Oxide.Ext.Chaos.dll"   "https://oxide.chaoscode.io/Oxide.Ext.Chaos.dll"
    fetch_ext "${DISCORD_EXT:-0}"  "Oxide.Ext.Discord.dll" "https://github.com/dassjosh/Oxide.Ext.Discord/releases/latest/download/Oxide.Ext.Discord.dll"
    fetch_ext "${RUSTEDIT_EXT:-0}" "Oxide.Ext.RustEdit.dll" "https://github.com/k1lly0u/Oxide.Ext.RustEdit/raw/master/Oxide.Ext.RustEdit.dll"
fi

# Record the active framework so the next boot can detect an oxide -> carbon/vanilla
# switch and restore vanilla assemblies (see FORCE_VALIDATE above).
echo "${FRAMEWORK}" > "${LAST_FW_FILE}" 2>/dev/null || true

# ---------------------------------------------------------------------------
# 4. Performance: optionally preload jemalloc alongside Carbon's doorstop.
#    jemalloc cuts Rust's memory fragmentation, BUT preloading it corrupts the
#    heap inside RustDedicated's bundled Mono.Posix string marshaling and crashes
#    Oxide's C# compiler ("free(): invalid size" in Mono.Unix FileNameMarshaler).
#    So it is OFF by default and force-skipped for Oxide even if requested.
# ---------------------------------------------------------------------------
PRELOAD=""
if [ "${USE_JEMALLOC:-0}" = "1" ] && [ -f "${JEMALLOC_LIB}" ]; then
    if [ "${FRAMEWORK}" = "oxide" ]; then
        log "jemalloc requested but skipped for Oxide (incompatible with Oxide's compiler)."
    else
        PRELOAD="${JEMALLOC_LIB}"
        log "jemalloc allocator enabled."
    fi
fi
[ -n "${CARBON_PRELOAD}" ] && PRELOAD="${PRELOAD:+${PRELOAD}:}${CARBON_PRELOAD}"
[ -n "${PRELOAD}" ] && export LD_PRELOAD="${PRELOAD}${LD_PRELOAD:+:${LD_PRELOAD}}"

# ---------------------------------------------------------------------------
# 5. Assemble RustDedicated launch arguments from the environment.
# ---------------------------------------------------------------------------
# The base command, used only when the panel did not supply one (an egg that
# still reads "start-rust" and nothing else). Migrated servers carry the same
# flags in their startup string, where the owner can see and edit them.
ARGS=(-batchmode -nographics)
ARGS+=(+server.port "${SERVER_PORT:-28015}")
ARGS+=(+server.queryport "${QUERY_PORT:-${SERVER_PORT:-28015}}")
ARGS+=(+server.identity "${SERVER_IDENTITY:-rust}")
ARGS+=(+server.hostname "${HOSTNAME:-A Rust Server}")
ARGS+=(+server.description "${DESCRIPTION:-Powered by Pterohost}")
ARGS+=(+server.maxplayers "${MAX_PLAYERS:-40}")
ARGS+=(+server.saveinterval "${SAVEINTERVAL:-60}")
ARGS+=(+server.tickrate "${TICKRATE:-30}")
ARGS+=(+rcon.port "${RCON_PORT:-28016}")
ARGS+=(+app.port "${APP_PORT:-28082}")

pterohost_panel_argv "$@"

if [ "${PTEROHOST_FROM_PANEL}" != "1" ]; then
    PTEROHOST_ARGS=("${BINARY}" "${ARGS[@]}")
fi

[ -n "${GAMEMODE:-}" ]    && pterohost_append_if_absent +server.gamemode +server.gamemode "${GAMEMODE}"
[ -n "${SERVER_URL:-}" ]  && pterohost_append_if_absent +server.url +server.url "${SERVER_URL}"
[ -n "${SERVER_IMG:-}" ]  && pterohost_append_if_absent +server.headerimage +server.headerimage "${SERVER_IMG}"
[ -n "${SERVER_LOGO:-}" ] && pterohost_append_if_absent +server.logoimage +server.logoimage "${SERVER_LOGO}"
[ -n "${SERVER_TAGS:-}" ] && pterohost_append_if_absent +server.tags +server.tags "${SERVER_TAGS}"

# rcon.web is not optional here - the console bridge below is the only way panel
# input reaches RustDedicated, which does not read stdin. The password is a
# credential, so neither of these belongs in the startup string.
pterohost_append_if_absent +rcon.password +rcon.password "${RCON_PASS:-}"
pterohost_append_if_absent +rcon.web +rcon.web true
# Rust+ companion needs a PUBLIC IPv4. If APP_PUBLIC_IP is unset or a private
# address (a stale internal value from the panel allocator), auto-detect the
# node's public IPv4 - curl -4 forces IPv4 (Facepunch's connectivity test is
# IPv4-only and fails on an IPv6 auto-detect).
PUBIP="${APP_PUBLIC_IP:-}"
case "${PUBIP}" in
    ""|10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|127.*|169.254.*)
        PUBIP="$(curl -4 -s --max-time 10 https://api.ipify.org 2>/dev/null || curl -4 -s --max-time 10 https://ifconfig.me 2>/dev/null || echo '')"
        ;;
esac
case "${PUBIP}" in
    ""|10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|127.*|169.254.*) ;;
    *) pterohost_append_if_absent +app.publicip +app.publicip "${PUBIP}" ;;
esac
[ "${FPS_LIMIT:-0}" != "0" ] && pterohost_append_if_absent +fps.limit +fps.limit "${FPS_LIMIT}"
[ -n "${GC_BUFFER:-}" ]      && pterohost_append_if_absent +gc.buffer +gc.buffer "${GC_BUFFER}"

# Map: custom .map URL wins; otherwise procedural (level + worldsize + seed).
# The either/or is why this stays here rather than in the startup string - a
# static line cannot express "these three, unless that one".
if [ -n "${MAP_URL:-}" ]; then
    pterohost_append_if_absent +server.levelurl +server.levelurl "${MAP_URL}"
elif ! pterohost_has_flag +server.levelurl "${PTEROHOST_ARGS[@]}"; then
    pterohost_append_if_absent +server.level +server.level "${LEVEL:-Procedural Map}"
    pterohost_append_if_absent +server.worldsize +server.worldsize "${WORLD_SIZE:-3000}"
    pterohost_append_if_absent +server.seed +server.seed "${WORLD_SEED:-1234}"
fi

# ---------------------------------------------------------------------------
# 6. Launch RustDedicated + panel-console bridge.
#    RustDedicated does NOT read stdin, but stdin is exactly where Wings
#    delivers panel-console input (including the egg stop command "quit"), so
#    without a bridge the console silently ignores every command. Forward each
#    stdin line to the server's local WebRCON endpoint (rcon.web is always on,
#    see ARGS above) and echo the direct reply back to stdout so it shows up in
#    the panel. Broadcast RCON messages (Identifier 0) are skipped - the server
#    already prints its log to stdout and they would duplicate every line.
# ---------------------------------------------------------------------------
RCON_URL="ws://127.0.0.1:${RCON_PORT:-28016}/${RCON_PASS:-}"

rcon_up() { timeout 2 bash -c "exec 3<>/dev/tcp/127.0.0.1/${RCON_PORT:-28016}" 2>/dev/null; }

rcon_send() { # <command> - prints the command's own reply (Identifier 1)
    jq -cn --arg m "$1" '{Identifier: 1, Message: $m, Name: "WebRcon"}' \
        | timeout "${RCON_REPLY_WINDOW:-5}" websocat -t "${RCON_URL}" 2>/dev/null \
        | jq --unbuffered -Rr 'fromjson? | select(.Identifier == 1 and (.Message // "") != "") | .Message' 2>/dev/null
}

console_bridge_line() { # <line>
    local line="${1%$'\r'}"
    [ -z "${line}" ] && return 0
    if rcon_up; then
        rcon_send "${line}"
    elif [ "${line,,}" = "quit" ]; then
        log "console: RCON is not up - stopping the server with SIGTERM instead of 'quit'."
        kill -TERM "${SERVER_PID}" 2>/dev/null
    else
        log "console: RCON is not reachable (server still starting?) - command dropped: ${line}"
    fi
}

# The bridge used to be a plain `while read` loop, so the first end-of-file on
# stdin ended it for the life of the container: a ^D on the console tty, or
# Wings dropping and re-attaching the stream. RustDedicated kept running with no
# path for console input left - panel commands vanished and the egg's stop
# command `quit` never arrived, so every Stop/Restart hung in "stopping" until
# Wings killed the container without a save (tickets 4683 and 4785, node12,
# 2026-10-23: one start-rust process in the container instead of two). EOF now
# only means "nothing to read right now": a partial line is still delivered, and
# reading resumes on the same descriptor once input flows again.
console_bridge() {
    local line closed=0
    trap '' HUP
    while :; do
        if IFS= read -r line; then
            closed=0
            console_bridge_line "${line}"
            continue
        fi
        [ -n "${line}" ] && console_bridge_line "${line}"
        if [ "${closed}" = "0" ]; then
            log "console: input stream closed - keeping the console bridge up for when it reopens."
            closed=1
        fi
        sleep "${BRIDGE_EOF_SLEEP:-1}"
    done
}

start_bridge() {
    console_bridge <&3 &
    BRIDGE_PID=$!
}

# Waits for RustDedicated and keeps the bridge alive while it runs: should the
# bridge die anyway (a signal, a bug), it is restarted rather than leaving the
# server deaf to `quit` again. Sets EXIT_CODE to the server's own exit status.
rust_supervise() {
    local waited rc
    EXIT_CODE=0
    while :; do
        waited=""
        if [ -n "${BRIDGE_PID}" ]; then
            wait -n -p waited "${SERVER_PID}" "${BRIDGE_PID}"
        else
            wait -n -p waited "${SERVER_PID}"
        fi
        rc=$?
        if [ "${waited}" = "${SERVER_PID}" ]; then
            EXIT_CODE="${rc}"
            break
        fi
        if [ -n "${BRIDGE_PID}" ] && [ "${waited}" = "${BRIDGE_PID}" ]; then
            BRIDGE_PID=""
            if kill -0 "${SERVER_PID}" 2>/dev/null; then
                log "console: bridge stopped (status ${rc}) - restarting it."
                sleep 1
                start_bridge
            fi
            continue
        fi
        kill -0 "${SERVER_PID}" 2>/dev/null && continue
        wait "${SERVER_PID}"
        EXIT_CODE=$?
        break
    done
    [ -n "${BRIDGE_PID}" ] && kill "${BRIDGE_PID}" 2>/dev/null
    return 0
}

# A migrated egg carries {{ADDITIONAL_ARGS}} in the startup string itself.
if [ "${PTEROHOST_FROM_PANEL}" != "1" ] && [ -n "${ADDITIONAL_ARGS:-}" ]; then
    # shellcheck disable=SC2206
    PTEROHOST_ARGS+=(${ADDITIONAL_ARGS})
fi

log "framework=${FRAMEWORK} branch=${BRANCH} launching RustDedicated"
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"

"${PTEROHOST_ARGS[@]}" &
SERVER_PID=$!

# tini -g already signals the whole process group; forward explicitly as well
# so a signal delivered only to this shell still reaches the server.
trap 'kill -TERM "${SERVER_PID}" 2>/dev/null' TERM INT

# Background jobs default stdin to /dev/null; hand the bridge the real
# container stdin through fd 3.
exec 3<&0
start_bridge

rust_supervise
log "RustDedicated exited with code ${EXIT_CODE}."
exit "${EXIT_CODE}"
