#!/bin/bash
# Pterohost Valheim bootstrap (BepInEx-aware).
#
# Two things matter here:
#
# 1. SIGTERM must become SIGINT. Valheim only writes the world on SIGINT; a
#    plain TERM loses whatever happened since the last autosave. The old egg
#    encoded this as `trap "kill -2 $!; wait;" 15` inside the startup string.
#
# 2. The query port is gameport+1, and Valheim binds it itself - the panel does
#    not allocate it. That is why the panel's query registry allows an
#    unassigned +1 for this game specifically.
#
# 3. -world names the save, and it is an editable panel field. Changing it did
#    not rename the world, it pointed the server at a world that did not exist,
#    so the game generated a fresh one and the old map, bases and characters
#    stayed on disk under the old name with no way to reach them from the panel.
#    pterohost_ident_sync now moves the save to follow the field, rolled backups
#    included - leaving those behind would throw away the only copies that
#    survive a corrupted world.

set -u
cd /home/container || exit 1

# shellcheck source=/dev/null
. /usr/local/lib/pterohost/steam-update.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/identity.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/launch.sh

log() { pterohost_log "$@"; }

APPID="${SRCDS_APPID:-896660}"
BINARY="./valheim_server.x86_64"

if [ "${AUTO_UPDATE:-1}" = "1" ]; then
    pterohost_steam_update "${APPID}" "${SRCDS_BETAID:-}" "${VALIDATE:-0}" \
        "/home/container/valheim_server.x86_64" || true
else
    log "AUTO_UPDATE=0 - skipping SteamCMD."
    pterohost_steam_seed
    pterohost_steam_sdk
fi

# The save follows -world. Valheim keeps a world as <name>.db and <name>.fwl,
# the previous pair as .old, and its rolled autosaves as
# <name>_backup_auto-<timestamp>.{db,fwl}; all of them move together or not at
# all. See shared/identity.sh for the rules.
VALHEIM_SAVE_DIR="${HOME:-/home/container}/.config/unity3d/IronGate/Valheim"
if [ -d "${VALHEIM_SAVE_DIR}/worlds_local" ]; then
    (
        cd "${VALHEIM_SAVE_DIR}" || exit 0
        pterohost_ident_sync "/home/container/.pterohost-world-identity" "${WORLD:-Dedicated}" \
            'worlds_local/@.db' \
            'worlds_local/@.fwl' \
            'worlds_local/@.db.old' \
            'worlds_local/@.fwl.old' \
            'worlds_local/@_backup_auto-*.db' \
            'worlds_local/@_backup_auto-*.fwl'
    )
fi

# BepInEx, when the server has it installed. Loading doorstop unconditionally
# would break a vanilla server, so probe for the preloader first.
if [ "${BEPINEX_ENABLED:-1}" = "1" ] && [ -f "./BepInEx/core/BepInEx.Preloader.dll" ]; then
    export DOORSTOP_ENABLED=1
    export DOORSTOP_TARGET_ASSEMBLY="./BepInEx/core/BepInEx.Preloader.dll"
    export LD_LIBRARY_PATH="./doorstop_libs:${LD_LIBRARY_PATH:-}"
    export LD_PRELOAD="libdoorstop_x64.so${LD_PRELOAD:+:${LD_PRELOAD}}"
    log "BepInEx detected - doorstop enabled."
else
    log "Running vanilla (no BepInEx preloader found)."
fi

export LD_LIBRARY_PATH="./linux64:${LD_LIBRARY_PATH:-}"
export SteamAppId=892970

# The base command, used only when the panel did not supply one (an egg that
# still reads "start-valheim" and nothing else).
args=(
    -nographics -batchmode
    -name "${SERVER_NAME:-My Server}"
    -port "${SERVER_PORT}"
    -world "${WORLD:-Dedicated}"
    -public "${PUBLIC_SERVER:-1}"
    -saveinterval "${BACKUP_INTERVAL:-1800}"
    -backups "${BACKUP_COUNT:-4}"
    -backupshort "${BACKUP_SHORTTIME:-7200}"
    -backuplong "${BACKUP_LONGTIME:-43200}"
)

pterohost_panel_argv "$@"

if [ "${PTEROHOST_FROM_PANEL}" != "1" ]; then
    PTEROHOST_ARGS=("${BINARY}" "${args[@]}")
fi

[ "${ENABLE_CROSSPLAY:-0}" = "1" ] && pterohost_append_if_absent -crossplay -crossplay

# Credentials stay out of the startup string: the panel renders it with the
# variable values substituted in.
[ -n "${PASSWORD:-}" ] && pterohost_append_if_absent -password -password "${PASSWORD}"

# A migrated egg carries {{ADDITIONAL_ARGS}} in the startup string itself.
if [ "${PTEROHOST_FROM_PANEL}" != "1" ] && [ -n "${ADDITIONAL_ARGS:-}" ]; then
    # shellcheck disable=SC2206
    PTEROHOST_ARGS+=(${ADDITIONAL_ARGS})
fi

CHILD=""

# Turn the runtime's SIGTERM into the SIGINT Valheim actually saves on.
graceful_stop() {
    [ -n "${CHILD}" ] && kill -0 "${CHILD}" 2>/dev/null || return

    log "Stop requested - sending SIGINT so the world is saved."
    kill -INT "${CHILD}" 2>/dev/null || true

    for _ in $(seq 1 "${VALHEIM_STOP_TIMEOUT:-90}"); do
        kill -0 "${CHILD}" 2>/dev/null || { log "Server exited cleanly."; return; }
        sleep 1
    done

    log "Still running after the stop timeout - escalating."
    kill -TERM "${CHILD}" 2>/dev/null || true
}

trap graceful_stop SIGTERM SIGINT

log "Starting Valheim '${SERVER_NAME:-My Server}' on port ${SERVER_PORT} (query $((SERVER_PORT + 1)))."
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"

# Unity writes a lot of "(Filename: ...)" noise that drowns the console.
if [ -n "${CONSOLE_FILTER:-}" ]; then
    "${PTEROHOST_ARGS[@]}" > >(sed -uE "${CONSOLE_FILTER}") 2>&1 &
else
    "${PTEROHOST_ARGS[@]}" &
fi

CHILD=$!
wait "${CHILD}"
