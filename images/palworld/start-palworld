#!/bin/bash
# Pterohost Palworld dedicated-server bootstrap.
#
# Why this image exists:
#
# 1. THE SETTINGS ACTUALLY REACHING THE SERVER. Palworld keeps every setting in
#    one Unreal tuple inside PalWorldSettings.ini, and three separate things
#    used to stop a panel value from arriving:
#
#      a. the third-party PalworldServerConfigParser the old egg shipped ends
#         the replaced value at the first comma AFTER THE KEY, so a name or
#         description containing a comma grew one duplicated tail per boot until
#         the quotes no longer balanced. Two live servers had been rewriting
#         themselves for weeks, one of them cut off mid-value with no closing
#         parenthesis at all. We no longer run it; shared/unrealini.awk owns the
#         tuple and repairs that damage on the way past.
#
#      b. WorldOption.sav. When a world is uploaded from the client, or was
#         created before the panel set a value, Palworld takes the world's
#         settings from Pal/Saved/SaveGames/0/<id>/WorldOption.sav and ignores
#         PalWorldSettings.ini completely - including AdminPassword, which then
#         stays EMPTY. Seven servers on this fleet were in that state: the panel
#         showed one admin password, the server accepted a blank one from
#         anybody who could reach the RCON port, and every settings change the
#         customer made did nothing. The file is renamed aside (never deleted)
#         so the panel is the single source of truth; PAL_KEEP_WORLD_OPTION=1
#         restores the old behaviour for a server that wants it.
#
#      c. a sed whose delimiter collided with its own alternation, so no
#         existing key was ever updated. The tuple writer replaced it.
#
#    The flip side of fixing those: every key in shared/palworld-keys.tsv is
#    now rewritten from the panel on every boot, so an owner who edits one of
#    them in the file by hand loses it at the next start - which reads as "the
#    file gets overwritten" and was a recurring complaint. PAL_MANAGE_SETTINGS=0
#    hands the file back: only the ports and the RCON/REST switches are written,
#    because those follow the panel's allocations and cannot be owner-owned.
#    Everything else is then read from the ini exactly as left, and the matching
#    fields in the panel stop having any effect. Default stays 1.
#
# 2. STOPPING. Palworld does not read stdin, so the egg's stop command has to
#    arrive as a signal and the shutdown itself has to go over RCON. The old egg
#    had a stdin->RCON bridge and the first version of this image dropped it,
#    which is why Stop hung until Wings killed the process.
#
# 3. QUERY. Palworld answers no Valve A2S on any port - verified by sweeping the
#    game port, +1, +2, +24714, QUERY_PORT, RCON_PORT and every allocation on
#    running servers. RCON and the REST API are the only ways to read its state.
#
# 4. LATENCY. -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS are the
#    three flags Pocketpair documents for dedicated servers; they cost nothing
#    and improve CPU utilisation on a game that is otherwise brutally
#    single-thread bound. jemalloc is available as an opt-in preload because
#    UE5 servers fragment the default allocator over long uptimes.
#
# 5. TWO RUNTIMES, ONE SCRIPT. The Proton image (palworld_proton) runs the
#    Windows depot so that RE-UE4SS mods load, and differs from the native build
#    in four places: the Steam platform, the binary, the config directory Unreal
#    reads, and how the process is launched and stopped. Everything above -
#    which is where all the bugs were - is identical, so PAL_RUNTIME branches
#    here instead of a second copy of this file drifting out of sync.

set -u
cd /home/container || exit 1

# shellcheck source=/dev/null
. /usr/local/lib/pterohost/steam-update.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/launch.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/kvconf.sh
# shellcheck source=/dev/null
. /usr/local/lib/pterohost/unrealini.sh

log() { pterohost_log "$@"; }

APPID="${SRCDS_APPID:-2394010}"

# Which build of the dedicated server this image runs. Set by the Dockerfile,
# not by the egg: the two runtimes need different Steam depots, so a server able
# to flip this per boot would spend every other start re-downloading the other
# platform's files. Choosing the image in the panel is what chooses the runtime.
#
#   linux  - the native depot. Faster, and what a server should use unless it
#            needs mods.
#   proton - the Windows depot under GE-Proton. Slower (a translation layer on
#            a game that is already single-thread bound) and worth it only
#            because Palworld's mod ecosystem is RE-UE4SS, a Windows DLL that
#            does not load into the native build at all.
PAL_RUNTIME="${PAL_RUNTIME:-linux}"

PAL_LINUX_BINARY="/home/container/Pal/Binaries/Linux/PalServer-Linux-Shipping"
PAL_WIN_BINARY="/home/container/Pal/Binaries/Win64/PalServer-Win64-Shipping.exe"

case "${PAL_RUNTIME}" in
    proton)
        BINARY="${PAL_WIN_BINARY}"
        # Unreal writes its config under the platform it was built for, so the
        # Windows build reads WindowsServer/ and never looks at LinuxServer/.
        # Pointing the settings writer at the wrong one fails silently: the
        # server boots on defaults and every panel setting appears to do nothing.
        PAL_CONFIG_DIR="/home/container/Pal/Saved/Config/WindowsServer"
        export STEAMCMD_PLATFORM=windows
        ;;
    *)
        PAL_RUNTIME=linux
        BINARY="${PAL_LINUX_BINARY}"
        PAL_CONFIG_DIR="/home/container/Pal/Saved/Config/LinuxServer"
        ;;
esac

PAL_INI="${PAL_CONFIG_DIR}/PalWorldSettings.ini"
PAL_DEFAULTS="/home/container/DefaultPalWorldSettings.ini"
PAL_KEYS="/etc/pterohost/palworld-keys.tsv"
SAVE_DIR="/home/container/Pal/Saved/SaveGames/0"

# ---------------------------------------------------------------------------
# 0. Proton runtime. Every function here is a no-op on the native build.
# ---------------------------------------------------------------------------

# proton refuses to start without both of these and says so with a bare Python
# traceback that names neither. Both point inside the server volume, so the
# prefix - and anything a mod wrote into it - survives a container rebuild.
pal_proton_env() {
    export STEAM_COMPAT_DATA_PATH="${PAL_PROTON_PREFIX:-/home/container/.proton}"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="/home/container/.steam"
    # proton creates and owns pfx/ underneath. Naming it here is what lets the
    # stop path reach wineserver for the prefix the server is actually in.
    export WINEPREFIX="${STEAM_COMPAT_DATA_PATH}/pfx"
    mkdir -p "${STEAM_COMPAT_DATA_PATH}" "${STEAM_COMPAT_CLIENT_INSTALL_PATH}"
}

# The mod loader ships in the image but has to live in Pal/Binaries/Win64, which
# is inside the volume and is rewritten by every app_update. So it is synced in
# on each boot, keyed on a version stamp, and re-synced whenever the files have
# gone missing - which is exactly what a Steam validate does to them.
#
# Only the loader itself is overwritten. Mods/ is seeded once and then left
# alone: that is where the owner's mods and their settings live, and clobbering
# it on an image bump would delete work the panel never backed up.
pal_sync_ue4ss() {
    local src="${PAL_UE4SS_DIR:-/opt/pterohost/ue4ss}"
    local dst="/home/container/Pal/Binaries/Win64"
    local stamp="/home/container/.pterohost-ue4ss-version"
    local want have

    [ -d "${src}/payload" ] || return 0

    if [ ! -d "${dst}" ]; then
        log "WARN: ${dst} does not exist - skipping the RE-UE4SS install. The Windows depot has probably not downloaded yet."
        return 0
    fi

    want="$(cat "${src}/VERSION" 2>/dev/null || echo unknown)"
    have="$(cat "${stamp}" 2>/dev/null || echo none)"

    if [ "${have}" = "${want}" ] && [ -f "${dst}/winmm.dll" ] && [ -f "${dst}/UE4SS.dll" ]; then
        return 0
    fi

    if ! cp -f "${src}/payload/winmm.dll" "${src}/payload/UE4SS.dll" "${dst}/" 2>/dev/null; then
        log "WARN: could not install RE-UE4SS into ${dst} - the server starts, but without mod support."
        return 0
    fi
    [ -f "${dst}/UE4SS-settings.ini" ] || cp -f "${src}/payload/UE4SS-settings.ini" "${dst}/" 2>/dev/null || true
    [ -d "${dst}/Mods" ] || cp -a "${src}/payload/Mods" "${dst}/" 2>/dev/null || true

    printf '%s\n' "${want}" > "${stamp}" 2>/dev/null || true
    log "RE-UE4SS ${want} installed into Pal/Binaries/Win64 - mods go in Mods/, enable them in Mods/mods.txt."
}

if [ "${PAL_RUNTIME}" = "proton" ]; then
    pal_proton_env
fi

# ---------------------------------------------------------------------------
# 1. Update via anonymous SteamCMD.
# ---------------------------------------------------------------------------
if [ "${AUTO_UPDATE:-1}" = "1" ]; then
    pterohost_steam_update "${APPID}" "${SRCDS_BETAID:-}" "${STEAM_VALIDATE:-0}" "${BINARY}" || true
else
    log "AUTO_UPDATE=0 - skipping SteamCMD, using existing server files."
    pterohost_steam_seed
    pterohost_steam_sdk
fi

# After the update, not before: app_update rewrites Pal/Binaries/Win64 and takes
# the loader with it.
if [ "${PAL_RUNTIME}" = "proton" ]; then
    pal_sync_ue4ss
fi

# ---------------------------------------------------------------------------
# 2. A settings file we can actually write to.
#
# A server whose install was interrupted ends up with an empty or truncated
# PalWorldSettings.ini - one volume on this fleet holds a single byte. Seeding
# it from the shipped defaults costs nothing and turns "no setting works" into
# a normal boot.
# ---------------------------------------------------------------------------
mkdir -p "${PAL_CONFIG_DIR}"

if [ ! -s "${PAL_INI}" ] || ! grep -q "OptionSettings" "${PAL_INI}" 2>/dev/null; then
    if [ -s "${PAL_DEFAULTS}" ] && grep -q "OptionSettings" "${PAL_DEFAULTS}" 2>/dev/null; then
        log "No usable PalWorldSettings.ini - seeding it from DefaultPalWorldSettings.ini."
        cp -f "${PAL_DEFAULTS}" "${PAL_INI}"
    else
        log "WARN: neither PalWorldSettings.ini nor DefaultPalWorldSettings.ini is usable; the server boots on built-in defaults."
    fi
fi

# ---------------------------------------------------------------------------
# 3. WorldOption.sav - see point 1b in the header.
# ---------------------------------------------------------------------------
if [ "${PAL_KEEP_WORLD_OPTION:-0}" != "1" ] && [ -d "${SAVE_DIR}" ]; then
    find "${SAVE_DIR}" -maxdepth 2 -name 'WorldOption.sav' 2>/dev/null | while IFS= read -r world_option; do
        [ -n "${world_option}" ] || continue
        if mv -f "${world_option}" "${world_option}.pterohost-disabled" 2>/dev/null; then
            log "WorldOption.sav in the save was overriding every setting in PalWorldSettings.ini - including the admin/RCON password - and has been moved aside. The ini is the source of truth again; set PAL_KEEP_WORLD_OPTION=1 to keep the world's own copy instead."
        fi
    done
fi

# ---------------------------------------------------------------------------
# 4. Write the settings the panel owns.
#
# The mapping lives in /etc/pterohost/palworld-keys.tsv, so adding a setting is
# one line there plus a variable on the egg. Values are formatted per the
# declared type: Palworld writes its rates as 1.000000 and the parsers around it
# have rejected a bare "1".
# ---------------------------------------------------------------------------
apply_settings() {
    local env_name key type value

    unreal_begin

    if [ "${PAL_MANAGE_SETTINGS:-1}" != "1" ]; then
        log "PAL_MANAGE_SETTINGS=0 - PalWorldSettings.ini belongs to you. Only the ports and RCON/REST are written; every gameplay setting is read from the file as you left it, and the matching fields in the panel do nothing until you set this back to 1."
    elif [ -f "${PAL_KEYS}" ]; then
        while IFS=$'\t' read -r env_name key type; do
            case "${env_name}" in ''|\#*) continue ;; esac
            [ -n "${key}" ] || continue

            eval "value=\${${env_name}:-}"
            [ -n "${value}" ] || continue

            case "${type}" in
                str)
                    unreal_str "${key}" "${value}"
                    ;;
                float)
                    case "${value}" in
                        *.*) unreal_set "${key}" "${value}" ;;
                        *)   unreal_set "${key}" "${value}.000000" ;;
                    esac
                    ;;
                *)
                    unreal_set "${key}" "${value}"
                    ;;
            esac
        done < "${PAL_KEYS}"
    else
        log "WARN: ${PAL_KEYS} missing - only the ports and RCON will be written."
    fi

    # Ports and switches follow the panel's allocations, not a typed-in value.
    unreal_set PublicPort "${SERVER_PORT}"

    if [ -n "${RCON_PORT:-}" ] && [ -n "${ADMIN_PASSWORD:-}" ]; then
        unreal_set RCONEnabled True
        unreal_set RCONPort "${RCON_PORT}"
        log "RCON enabled on port ${RCON_PORT}."
    else
        log "RCON not configured (RCON_PORT/ADMIN_PASSWORD unset) - the panel cannot list players and Stop cannot shut the server down cleanly."
    fi

    # The REST API carries names, ping, level, server FPS and uptime; RCON
    # carries only names. Enabled solely when the egg allocated a port for it,
    # so we never squat a port the panel did not hand out.
    if [ -n "${REST_PORT:-}" ] && [ -n "${ADMIN_PASSWORD:-}" ]; then
        unreal_set RESTAPIEnabled True
        unreal_set RESTAPIPort "${REST_PORT}"
        log "REST API enabled on port ${REST_PORT}."
    else
        log "REST_PORT unset - the panel falls back to RCON for player data."
    fi

    kv_backup_once "${PAL_INI}" settings

    local owner="the panel"
    [ "${PAL_MANAGE_SETTINGS:-1}" = "1" ] || owner="the panel (ports and RCON/REST only)"

    unreal_apply "${PAL_INI}"
    case $? in
        0) log "Server settings written from ${owner}." ;;
        1) log "Server settings already match ${owner}." ;;
        *) log "WARN: could not write PalWorldSettings.ini - the server keeps its current settings." ;;
    esac
}

if [ "${PAL_LEGACY_PARSER:-0}" = "1" ] && [ -x /home/container/PalworldServerConfigParser ]; then
    log "PAL_LEGACY_PARSER=1 - running the third-party config parser (known to corrupt any value containing a comma)."
    ./PalworldServerConfigParser || log "WARN: config parser exited non-zero; continuing."
fi

apply_settings

# ---------------------------------------------------------------------------
# 5. Launch.
# ---------------------------------------------------------------------------
# Both of these are about loading a Linux ELF, and the Proton runtime runs a PE.
# LD_PRELOAD in particular is not merely useless there - it is inherited by every
# helper Proton spawns and reliably breaks the prefix setup before wine starts.
if [ "${PAL_RUNTIME}" = "linux" ]; then
    if [ "${USE_JEMALLOC:-0}" = "1" ] && [ -f "${JEMALLOC_LIB:-}" ]; then
        export LD_PRELOAD="${JEMALLOC_LIB}${LD_PRELOAD:+:${LD_PRELOAD}}"
        log "jemalloc preloaded."
    fi

    export LD_LIBRARY_PATH="/home/container/.steam/sdk64:${LD_LIBRARY_PATH:-}"
elif [ "${USE_JEMALLOC:-0}" = "1" ]; then
    log "USE_JEMALLOC=1 ignored - the Proton runtime runs a Windows binary, which does not use the system allocator."
fi

# The base command, used only when the panel did not supply one (an egg that
# still reads "start-palworld" and nothing else).
args=(
    Pal
    -port="${SERVER_PORT}"
    -publicport="${SERVER_PORT}"
    -servername="${SERVER_NAME:-Palworld}"
)

pterohost_panel_argv "$@"

if [ "${PTEROHOST_FROM_PANEL}" != "1" ]; then
    PTEROHOST_ARGS=("${BINARY}" "${args[@]}")
elif [ "${PAL_RUNTIME}" = "proton" ]; then
    # The egg's startup string names the native binary and is shared by both
    # images, so the Proton image swaps element 0 rather than asking every owner
    # to edit a line they did not write. Both spellings, because that line is
    # owner-editable and some have made the path absolute.
    pterohost_swap_binary ./Pal/Binaries/Linux/PalServer-Linux-Shipping "${BINARY}"
    pterohost_swap_binary "${PAL_LINUX_BINARY}" "${BINARY}"
fi

# Appended only where the startup command does not already say otherwise.
[ -n "${QUERY_PORT:-}" ] && pterohost_append_if_absent -queryport "-queryport=${QUERY_PORT}"
[ -n "${MAX_PLAYERS:-}" ] && pterohost_append_if_absent -players "-players=${MAX_PLAYERS}"
[ -n "${PUBLIC_IP:-}" ] && pterohost_append_if_absent -publicip "-publicip=${PUBLIC_IP}"

# The documented performance trio. Opt-out exists in case a future build
# regresses on one of them.
if [ "${PAL_PERF_FLAGS:-1}" = "1" ]; then
    pterohost_append_if_absent -useperfthreads -useperfthreads
    pterohost_append_if_absent -NoAsyncLoadingThread -NoAsyncLoadingThread
    pterohost_append_if_absent -UseMultithreadForDS -UseMultithreadForDS
fi

# -adminpassword / -serverpassword / -rcon are deliberately NOT appended.
# Palworld ignores them - a server launched with -adminpassword=X still refuses
# X over RCON when the ini says otherwise, verified on a live server - and
# appending them only printed the credentials into the customer's console.

# A migrated egg carries {{ADDITIONAL_ARGS}} in the startup string itself.
if [ "${PTEROHOST_FROM_PANEL}" != "1" ] && [ -n "${ADDITIONAL_ARGS:-}" ]; then
    # shellcheck disable=SC2206
    PTEROHOST_ARGS+=(${ADDITIONAL_ARGS})
fi

CHILD=""
BRIDGE=""

rcon_send() {
    command -v rcon >/dev/null 2>&1 || return 1
    [ -n "${RCON_PORT:-}" ] && [ -n "${ADMIN_PASSWORD:-}" ] || return 1
    rcon -s -a "localhost:${RCON_PORT}" -p "${ADMIN_PASSWORD}" "$1" 2>/dev/null
}

# Panel console -> RCON. Palworld reads nothing from stdin, so without this the
# console is write-only. stdin is duplicated to fd 4 first: a background loop
# reading plain stdin is handed /dev/null by the shell and exits immediately,
# which is exactly how the Zomboid console broke.
exec 4<&0

console_bridge() {
    local line
    while IFS= read -r line <&4; do
        [ -n "${line}" ] || continue
        rcon_send "${line}" || log "RCON is not configured - console command ignored: ${line}"
    done
}

# Wings decides a server has finished starting by matching a line of its output
# against the egg's done marker. The native build prints that line itself; the
# Proton build does not - the game's own stdout does not survive the launcher,
# so a server that is up, listening and answering RCON sits in "Starting" in the
# panel until Wings' own timeout, and the owner is told to wait for something
# that already happened. Two customers opened tickets about exactly this.
#
# RCON is the readiness signal that does exist on both builds: it only answers
# once the world is loaded. So on Proton we poll it and print the marker
# ourselves, once, in the same wording the egg matches.
PAL_DONE_MARKER="Running Palworld dedicated server on"

ready_probe() {
    local waited=0 limit="${PAL_READY_TIMEOUT:-1800}"
    while [ "${waited}" -lt "${limit}" ]; do
        kill -0 "${CHILD}" 2>/dev/null || return
        if rcon_send "Info" >/dev/null 2>&1; then
            printf '%s %s:%s\n' "${PAL_DONE_MARKER}" "${PUBLIC_IP:-0.0.0.0}" "${SERVER_PORT}"
            return
        fi
        sleep 5
        waited=$((waited + 5))
    done
    log "WARN: no RCON answer after ${limit}s - the panel will keep showing Starting even if the game is up."
}

graceful_stop() {
    # `return 0`, not a bare `return`: a bare one hands back the status of the
    # failed kill -0, so stopping an already-stopped server reported failure.
    # Nothing reads it today, which is exactly why it would go unnoticed.
    [ -n "${CHILD}" ] && kill -0 "${CHILD}" 2>/dev/null || return 0

    log "Stop requested - saving the world over RCON before shutting down."
    rcon_send "Save" >/dev/null 2>&1 || log "WARN: could not save over RCON; falling back to a plain stop."
    sleep 2
    rcon_send "Shutdown 1 Server_is_shutting_down" >/dev/null 2>&1

    local waited=0
    while [ "${waited}" -lt "${PAL_STOP_TIMEOUT:-25}" ]; do
        kill -0 "${CHILD}" 2>/dev/null || { log "Server exited cleanly."; return; }
        sleep 1
        waited=$((waited + 1))
    done

    log "Still running after ${PAL_STOP_TIMEOUT:-25}s - sending SIGTERM."
    kill -TERM "${CHILD}" 2>/dev/null || true

    # Under Proton, CHILD is the launcher, not the game: the server is a wine
    # process the launcher started and SIGTERM to the launcher leaves it running
    # until Wings kills the container 30s later, world unsaved. wineserver -k is
    # what actually reaches it.
    if [ "${PAL_RUNTIME}" = "proton" ]; then
        wineserver -k 2>/dev/null || "${PROTON_DIR:-/opt/pterohost-proton}/files/bin/wineserver" -k 2>/dev/null || true
    fi

    # Do not return while the game is still alive.
    #
    # Signalling is not stopping. Returning here ends the trap, `wait` returns,
    # the script exits and PID 1 with it - but PalServer is still running for as
    # long as it takes UE5 to unwind a loaded world. The nodes run containers on
    # the host network stack, so its sockets stay bound fleet-wide until the
    # process is actually reaped, and RCON's listen socket is the one that
    # matters: Wings sees the container exit, starts it again, and the new
    # PalServer cannot bind the RCON port because the old one still holds it.
    # The game then comes up with RCON silently absent - no player list, no
    # console, socket error 111 in the panel - and it stays that way until
    # something stops the server long enough for the port to clear.
    #
    # That is exactly why Restart broke the console while Stop, wait for
    # Offline, Start did not: the second path gives the old process time to die.
    # Waiting out the exit here is what makes the two paths equivalent.
    #
    # The budget is sized against Wings, not picked freely: Wings force-kills
    # the container `docker.timeouts.stop` seconds after asking it to stop (30
    # on this fleet), and a force-kill tears the whole container down, which is
    # safe but takes the shutdown out of our hands. So the three waits together
    # - PAL_STOP_TIMEOUT for the RCON shutdown, then these two - must stay
    # inside that, hence 25 + 3 + 2. Raise PAL_STOP_TIMEOUT for a world that
    # needs longer only together with the Wings timeout, or the extra seconds
    # are spent being killed rather than stopping.
    waited=0
    while [ "${waited}" -lt "${PAL_TERM_TIMEOUT:-3}" ]; do
        kill -0 "${CHILD}" 2>/dev/null || { log "Server exited after SIGTERM."; return; }
        sleep 1
        waited=$((waited + 1))
    done

    log "Still running ${PAL_TERM_TIMEOUT:-3}s after SIGTERM - sending SIGKILL."
    kill -KILL "${CHILD}" 2>/dev/null || true

    waited=0
    while [ "${waited}" -lt "${PAL_KILL_TIMEOUT:-2}" ]; do
        kill -0 "${CHILD}" 2>/dev/null || { log "Server stopped."; return; }
        sleep 1
        waited=$((waited + 1))
    done

    log "WARN: PalServer survived SIGKILL for ${PAL_KILL_TIMEOUT:-2}s - leaving it to Wings; the next start may come up without RCON."
}

trap graceful_stop SIGTERM SIGINT

# proton takes the command as its own arguments; the native build is the command.
#
# runinprefix, not run. `proton run` starts the game through steam.exe, which
# detaches it from the console: stdout and stdin both disappear. That is the
# "console output is broken under proton" every community Palworld-Proton egg
# documents, and on this panel it is worse than an inconvenience - Wings decides
# a server has finished starting by matching a line of its output, so a silent
# server sits in "starting" forever. runinprefix runs the binary directly in the
# same prefix and keeps both streams. PAL_PROTON_VERB=run is the way back if a
# future build turns out to need the steam.exe wrapper for Steam registration.
LAUNCHER=()
[ "${PAL_RUNTIME}" = "proton" ] && LAUNCHER=(proton "${PAL_PROTON_VERB:-runinprefix}")

# Wait for the RCON port to be genuinely free before starting the game.
#
# Making the stop path wait for the process to die removed the obvious half of
# the restart race, but not all of it: Palworld binds its RCON socket without
# SO_REUSEADDR, so a connection left over from the previous run in TIME_WAIT,
# LAST-ACK or CLOSE-WAIT is enough to make the bind fail. The panel polls the
# player list over RCON, so on a busy server there is nearly always such a
# leftover, and those states hang around for up to a minute. Palworld does not
# report the failure or retry - it just runs with no RCON at all, which is
# indistinguishable to the owner from the server being broken.
#
# Measured on a live server (26.08.2026): with only the stop-side fix, pressing
# Restart still lost RCON on two attempts out of four, and `ss` showed LAST-ACK
# entries on the RCON port each time it failed.
#
# The containers share the host network namespace, so ss here sees exactly the
# sockets that would block the bind. We wait them out rather than start into a
# port we already know is unusable. The wait is bounded: after the timeout we
# start anyway, because a server that is up without RCON still beats one that
# never starts.
wait_for_rcon_port() {
    [ -n "${RCON_PORT:-}" ] || return 0
    command -v ss >/dev/null 2>&1 || return 0

    local waited=0 limit="${PAL_PORT_WAIT_TIMEOUT:-45}" lingering
    while [ "${waited}" -lt "${limit}" ]; do
        lingering="$(ss -Hant "( sport = :${RCON_PORT} )" 2>/dev/null | wc -l)"
        [ "${lingering}" = "0" ] && {
            [ "${waited}" -gt 0 ] && log "RCON port ${RCON_PORT} is free after ${waited}s."
            return 0
        }
        [ "${waited}" = "0" ] && log "RCON port ${RCON_PORT} still has ${lingering} socket(s) from the previous run - waiting up to ${limit}s so RCON can bind."
        sleep 1
        waited=$((waited + 1))
    done

    log "WARN: RCON port ${RCON_PORT} was still busy after ${limit}s - starting anyway; the panel may show no player list until the next restart."
}

wait_for_rcon_port

log "Starting Palworld on the ${PAL_RUNTIME} runtime (game ${SERVER_PORT}, query ${QUERY_PORT:-unset}, rcon ${RCON_PORT:-off}, rest ${REST_PORT:-off})."
pterohost_log_cmd "${PTEROHOST_ARGS[@]}"

"${LAUNCHER[@]}" "${PTEROHOST_ARGS[@]}" &
CHILD=$!

console_bridge &
BRIDGE=$!

READY=""
if [ "${PAL_RUNTIME}" = "proton" ]; then
    ready_probe &
    READY=$!
fi

